        { const float16_t v0 = gelu1(hm[0][0]), v1 = gelu1(hm[0][1]), v2 = gelu1(hm[0][2]), v3 = gelu1(hm[0][3]);
          const float16_t v4 = gelu1(hm[0][4]), v5 = gelu1(hm[0][5]), v6 = gelu1(hm[0][6]), v7 = gelu1(hm[0][7]);
          g0[0] = floate4m3_t(CL8(v0)); g0[1] = floate4m3_t(CL8(v1)); g0[2] = floate4m3_t(CL8(v2)); g0[3] = floate4m3_t(CL8(v3));
          g0[4] = floate4m3_t(CL8(v4)); g0[5] = floate4m3_t(CL8(v5)); g0[6] = floate4m3_t(CL8(v6)); g0[7] = floate4m3_t(CL8(v7)); }
        { const float16_t v0 = gelu1(hm[1][0]), v1 = gelu1(hm[1][1]), v2 = gelu1(hm[1][2]), v3 = gelu1(hm[1][3]);
          const float16_t v4 = gelu1(hm[1][4]), v5 = gelu1(hm[1][5]), v6 = gelu1(hm[1][6]), v7 = gelu1(hm[1][7]);
          g1[0] = floate4m3_t(CL8(v0)); g1[1] = floate4m3_t(CL8(v1)); g1[2] = floate4m3_t(CL8(v2)); g1[3] = floate4m3_t(CL8(v3));
          g1[4] = floate4m3_t(CL8(v4)); g1[5] = floate4m3_t(CL8(v5)); g1[6] = floate4m3_t(CL8(v6)); g1[7] = floate4m3_t(CL8(v7)); }
#define MLP2_N(N) { \
        A8 a0, a1; \
        LDA8(a0, ow2, 0u, UC, 16u * (N)); \
        LDA8(a1, ow2, 1u, UC, 16u * (N)); \
        K32H(res[N], a0, g0, a1, g1) }
        EACH_T(MLP2_N)
    }
#if KIND == 4
    // ------------------------------------------------------------ L's expansion head: per-pixel reconstruction inputs
    {
        const uint hb = (mt * 16u + row) * HS + ch8;
        for (uint nt = 0u; nt < NT; ++nt)
            for (int i = 0; i < 8; ++i) HO[hb + 16u * nt + uint(i)] = float16_t(res[nt][i]);
        SYNC
        const uint li = gl_LocalInvocationID.x;
        const uint px = li & 7u, py = li >> 3;
        const ivec2 at = ivec2(X0 + int(px), Y0 + int(py));
        if (li < 64u && at.x >= 0 && at.y >= 0 && at.x < dp.size.x && at.y < dp.size.y)
        {
            const uint hp = (((py >> 2) * 2u + (px >> 2)) * 16u + (py & 3u) * 4u + (px & 3u)) * HS;
#ifdef L_DUMP
            for (uint c = 0u; c < UC; ++c) ldump.a[(uint(at.y) * uint(p.W) + uint(at.x)) * UC + c] = HO[hp + c];
#endif
#define V(c) float(HO[hp + uint(c)])
            imageStore(gateOut, at, unorm8Value(vec4(sigmoidL(V(LH_GATE0)), sigmoidL(V(LH_GATE1)), sigmoidL(V(LH_GATE2)), 0.0)));
            const vec3 m = vec3(V(LH_MIX0), V(LH_MIX1), V(LH_MIX2)), ex = exp2((m - max(max(m.x, m.y), m.z)) * 1.442695);
            imageStore(mixOut, at, unorm8Value(vec4(ex * (1.0 / (ex.z + (ex.x + ex.y))), 0.0)));
            const float a = dp.sigma * sigmoidL(clamp(V(LH_COVA), -20.0, 20.0)), b = dp.sigma * sigmoidL(clamp(V(LH_COVB), -20.0, 20.0));
            imageStore(covOut, at, vec4(a * a, b * b, a * b * tanhL(V(LH_RHO) * dp.rho), 0.0));
            imageStore(featOut, at, snorm8Value(vec4(tanhL(V(LH_FEAT0)), tanhL(V(LH_FEAT1)), tanhL(V(LH_FEAT2)), tanhL(V(LH_FEAT3)))));
#undef V
        }
    }
#else
    // ------------------------------------------------------------ the block output, FP8
    const uint dst = uint(ty * p.W + tx) * UC + ch8;
    if (inside)
        for (uint nt = 0u; nt < NT; ++nt)
        {
#define OUT8(I) out0.a[dst + 16u * nt + uint(I)] = floate4m3_t(CL8(res[nt][I]));
            OUT8(0) OUT8(1) OUT8(2) OUT8(3) OUT8(4) OUT8(5) OUT8(6) OUT8(7)
#undef OUT8
        }
#endif
    // ------------------------------------------------------------ patch merge: 2x2 tokens (4C) -> XC, half resolution
#if MERGE
    {
        // the 16 merged rows are gathered from the four waves: the row is the merged token of the lane's pixel
        const uint mrow = (byr >> 1) * 4u + (bxr >> 1), qq = (byr & 1u) * 2u + (bxr & 1u);
#define MG_W(N) { A8 y; MK8_F8(y, res[N]); coopMatStore(y, NB, 16u * S4 + mrow * S4 + qq * UC + 16u * (N) - row * S4, S4, RM); }
        EACH_T(MG_W)
        SYNC
        const uint MT = UXC / 16u, NI = (MT + 3u) / 4u;
        const int ym = (Y0 >> 1) + int(row >> 2), xm = (X0 >> 1) + int(row & 3u);
        const bool mok = ym >= 0 && ym < p.Hh / 2 && xm >= 0 && xm < p.W / 2;
#if PLANES
        const uint mt2 = uint(ym * (p.W / 2) + xm), mplane = uint(p.Hh / 2) * uint(p.W / 2) * 32u;
#define MADDR(C) ((C) >> 5) * mplane + mt2 * 32u + ((C) & 31u)
#else
        const uint md = uint(ym * (p.W / 2) + xm) * UXC;
#define MADDR(C) md + (C)
#endif
        for (uint i = 0u; i < NI; ++i)
        {
            const uint u = mt + 4u * i;
            if (u < MT)
            {
                HAC y = bias16(p.o[69] + 16u * u, UXC);
                for (uint kt = 0u; kt < 4u * UC / 16u; kt += 2u)
                {
                    B8 b0, b1; coopMatLoad(b0, NB, 16u * S4 + kt * 16u, S4, CM);
                    coopMatLoad(b1, NB, 16u * S4 + (kt + 1u) * 16u, S4, CM);
                    A8 a0, a1; LDA8(a0, p.o[68], kt, UXC, 16u * u);
                    LDA8(a1, p.o[68], kt + 1u, UXC, 16u * u);
