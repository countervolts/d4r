#endif
#if KIND == 3
    // ------------------------------------------------------------ L's input: features, embedding -> x0
#ifdef AMD_REGISTER_INPUT
    ACC XREG_[WPW][NT];
    uint featureWords_[8];
    {
        const uint ownWindow_ = mt0 + hf;
        const uint px_ = 4u * (ownWindow_ & 1u) + (row & 3u);
        const uint py_ = 4u * (ownWindow_ >> 1u) + (row >> 2u);
