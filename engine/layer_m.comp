#else
        {
        HAC v[WPW][2];
        FORW { v[w][0] = HAC(0.0); v[w][1] = HAC(0.0); }
#define V_G(A, B) { \
        const uint kt = A; \
        QW av0, av1; \
        LDQ(av0, VOFF, kt, 32u, 0u); \
        LDQ(av1, VOFF, kt + 1u, 32u, 0u); \
        FORW { K32H(v[w][0], av0, h1[A], av1, h1[B]) } \
        LDQ(av0, VOFF, kt, 32u, 16u); \
        LDQ(av1, VOFF, kt + 1u, 32u, 16u); \
        FORW { K32H(v[w][1], av0, h1[A], av1, h1[B]) } }
#ifdef L_HALF_INPUT
#define VOFF (50u + 2u * hd)
#else
#define VOFF ov
#endif
