        floate4m3_t fe_[32];
#ifdef M_AMD_SPLIT_FEATURES
        const uint at_ = ((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + pixel_) * 8u;
        [[unroll]] for (uint i_ = 0u; i_ < 8u; ++i_) {
            const fe4m3vec4 a_ = preparedFeatures.a[at_ + i_];
