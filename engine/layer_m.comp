layout(set = 0, binding = 3, std430) readonly buffer I8V { fe4m3vec4 w[]; } i8v;
void directLow(out B8 dst, uint kt, uint token, uint hf)
{
    const uint c = 16u * kt + 8u * hf;
#if PLANES
    const uint at = ((c >> 5) * uint(p.Hh / 2) * uint(p.W / 2) + token) * 32u + (c & 31u);
#else
