    const uint ownF1_ = hf == 0u ? featureWords_[1] : featureWords_[3];
    const uint ownF2_ = hf == 0u ? featureWords_[4] : featureWords_[6];
    const uint ownF3_ = hf == 0u ? featureWords_[5] : featureWords_[7];
    const uint otherF0_ = subgroupShuffleXor(hf == 0u ? featureWords_[2] : featureWords_[0], 16u);
    const uint otherF1_ = subgroupShuffleXor(hf == 0u ? featureWords_[3] : featureWords_[1], 16u);
    const uint otherF2_ = subgroupShuffleXor(hf == 0u ? featureWords_[6] : featureWords_[4], 16u);
    const uint otherF3_ = subgroupShuffleXor(hf == 0u ? featureWords_[7] : featureWords_[5], 16u);
#else
    {
        const float e1 = ep.expo == 0.0 ? 1.0 : ep.expo, e2 = ep.expoPrev == 0.0 ? 1.0 : ep.expoPrev;
        const uint li = gl_LocalInvocationID.x;
