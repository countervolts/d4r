#else
void main()
{
#ifdef M_SCALAR_WAVE
    const uint mt0 = subgroupBroadcastFirst(gl_LocalInvocationID.x >> 5) * uint(WPW), lane = gl_LocalInvocationID.x & 31u;
#else
    const uint mt0 = (gl_LocalInvocationID.x >> 5) * uint(WPW), lane = gl_LocalInvocationID.x & 31u;
