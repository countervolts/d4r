                (uint(floate4m3BitsToUintEXT(fe_[4u * k_ + 1u])) << 8u) |
                (uint(floate4m3BitsToUintEXT(fe_[4u * k_ + 2u])) << 16u) |
                (uint(floate4m3BitsToUintEXT(fe_[4u * k_ + 3u])) << 24u);
