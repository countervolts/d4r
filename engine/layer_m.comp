// NVIDIA's softmax numerator, two neighbouring columns in one 32-bit word (the even column's carry reaches the odd)
void softmax2(float16_t s0, float16_t s1, out float16_t e0, out float16_t e1)
{
    const float16_t lim = float16_t(0.55615234375);
    const float16_t cs = float16_t(0.0972222164273262 / 5.656854152679443);
    const float16_t t0 = clamp(s0 * cs, -lim, lim), t1 = clamp(s1 * cs, -lim, lim);
    const float16_t p0 = fma(t0, fma(t0, -t0, float16_t(0.92730712890625)), float16_t(1.375));
    const float16_t p1 = fma(t1, fma(t1, -t1, float16_t(0.92730712890625)), float16_t(1.375));
    const uint w = ((uint(float16BitsToUint16(p0)) | (uint(float16BitsToUint16(p1)) << 16)) << 5) + 0x7FF88000u;
    e0 = uint16BitsToFloat16(uint16_t(w & 0xFFFFu)); e1 = uint16BitsToFloat16(uint16_t(w >> 16));
}
// M_PK16 (part of M_RELAXED): the softmax numerator on a packed pair, five packed operations for the two columns
// instead of eight scalar ones, and P V's keys in this GPU's order (no ZK permutation, which only ZLUDA's order needs)
#if defined(M_PK16) && !defined(M_RELAXED)
#error layer_m.comp: M_PK16 needs M_RELAXED
#endif
f16vec2 softmax2v(f16vec2 s)
{
    const f16vec2 t = clamp(s * float16_t(0.0972222164273262 / 5.656854152679443), f16vec2(-0.55615234375), f16vec2(0.55615234375));
    const f16vec2 p = fma(t, fma(t, -t, f16vec2(0.92730712890625)), f16vec2(1.375));
    return unpackFloat2x16((packFloat2x16(p) << 5) + 0x7FF88000u);
}
float16_t gelu1(float16_t x)
{
    const float16_t c = clamp(x, float16_t(-2.0), float16_t(2.0));
    const float16_t ac = abs(c);
    precise float16_t inner = float16_t(0.41216981) - float16_t(0.08108133) * ac;
    precise float16_t outer = float16_t(0.5) + c * inner;
    return x * outer;
}
#if C == 32
#define EACH_T(X) X(0) X(1)
#define EACH_T16(X) X(0, 1)
#elif C == 64
#define EACH_T(X) X(0) X(1) X(2) X(3)
#define EACH_T16(X) X(0, 1) X(2, 3)
#elif C == 96
#define EACH_T(X) X(0) X(1) X(2) X(3) X(4) X(5)
#define EACH_T16(X) X(0, 1) X(2, 3) X(4, 5)
#else
#define EACH_T(X) X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7)
#define EACH_T16(X) X(0, 1) X(2, 3) X(4, 5) X(6, 7)
#endif

// ------------------------------------------------------------------ native arithmetic order
// The accuracy build (kernels/build.sh D4R_PREFER_ACCURACY=1 -> -DD4R_ACCURACY -> SWIN_EXACT, and
// D4R_NATIVE_FP8=1 -> -DD4R_FP8_WMMA -> SWIN_A8/K32_MIX) runs the token-lane block of kernels/m/swin_tok.h.
// Its two non-obvious orderings are reproduced here in binary16:
//  * tok_rsq: per tile pp = a*a + b*b over the pairs (0,1)-(2,3) and (4,5)-(6,7), then a tree that splits the
//    tiles by parity, then a + other(a) across the half-waves, then u[0] + u[1], then the two components.
//  * the softmax: v1[k] = wg[k] + other(wg[k]) elementwise first, then (v1[0]+v1[1]) + (v1[2]+v1[3]).
// f16 arithmetic is marked precise so nothing is contracted into an FMA (the native kernel builds with
// #pragma clang fp contract(off)).
#define SH16(v) subgroupShuffleXor(packHalf2x16(vec2(float((v).x), float((v).y))), 16u)
#define UN16(p) f16vec2(float16_t(unpackHalf2x16(p).x), float16_t(unpackHalf2x16(p).y))
#if TEXL
// rsqrt.approx as ZLUDA lowers it (v_rsq_f32)
#define RSQ16(S) float16_t(inversesqrt(float(float16_t((S) + float16_t(0.0001220703125)))))
#else
#define RSQ16(S) float16_t(1.0 / sqrt(float(float16_t((S) + float16_t(0.0001220703125)))))
#endif
#if TEXL
// SWIN_TOK_NATURAL's tok_rsq: the lane's own channels 16T + 8hf + I; per g the tiles of each parity (WS), the two
// parities, then g, then the halves
#if C == 32
#define WS(P, ww) P[ww]
#elif C == 64
#define WS(P, ww) (P[ww] + P[2 + ww])
#elif C == 96
#define WS(P, ww) ((P[ww] + P[2 + ww]) + P[4 + ww])
#else
#define WS(P, ww) ((P[ww] + P[2 + ww]) + (P[4 + ww] + P[6 + ww]))
#endif
#define RSQ_TREE(OUT) { \
    f16vec2 P0_[NT], P1_[NT]; \
    EACH_T(RSQ_TILE) \
    precise f16vec2 W00_ = WS(P0_, 0), W10_ = WS(P0_, 1), W01_ = WS(P1_, 0), W11_ = WS(P1_, 1); \
    precise f16vec2 U0_ = W00_ + W10_, U1_ = W01_ + W11_; \
    precise f16vec2 A_ = U0_ + U1_; \
    precise f16vec2 S_ = A_ + UN16(SH16(A_)); \
    OUT = RSQ16(S_.x + S_.y); }
#elif C == 32
#define RSQ_TREE(OUT) { \
    f16vec2 P0_[NT], P1_[NT]; \
    EACH_T(RSQ_TILE) \
    precise f16vec2 A0_ = P0_[0] + P0_[1], A1_ = P1_[0] + P1_[1]; \
    precise f16vec2 U0_ = A0_ + UN16(SH16(A0_)), U1_ = A1_ + UN16(SH16(A1_)); \
    precise f16vec2 S_ = U0_ + U1_; \
    OUT = RSQ16(S_.x + S_.y); }
#elif C == 64
#define RSQ_TREE(OUT) { \
    f16vec2 P0_[NT], P1_[NT]; \
    EACH_T(RSQ_TILE) \
    precise f16vec2 W00_ = P0_[0] + P0_[2], W01_ = P1_[0] + P1_[2]; \
    precise f16vec2 W10_ = P0_[1] + P0_[3], W11_ = P1_[1] + P1_[3]; \
    precise f16vec2 A0_ = W00_ + W10_, A1_ = W01_ + W11_; \
    precise f16vec2 U0_ = A0_ + UN16(SH16(A0_)), U1_ = A1_ + UN16(SH16(A1_)); \
    precise f16vec2 S_ = U0_ + U1_; \
    OUT = RSQ16(S_.x + S_.y); }
#elif C == 96
#define RSQ_TREE(OUT) { \
    f16vec2 P0_[NT], P1_[NT]; \
    EACH_T(RSQ_TILE) \
    precise f16vec2 W00_ = (P0_[0] + P0_[2]) + P0_[4], W01_ = (P1_[0] + P1_[2]) + P1_[4]; \
    precise f16vec2 W10_ = (P0_[1] + P0_[3]) + P0_[5], W11_ = (P1_[1] + P1_[3]) + P1_[5]; \
    precise f16vec2 A0_ = W00_ + W10_, A1_ = W01_ + W11_; \
    precise f16vec2 U0_ = A0_ + UN16(SH16(A0_)), U1_ = A1_ + UN16(SH16(A1_)); \
    precise f16vec2 S_ = U0_ + U1_; \
    OUT = RSQ16(S_.x + S_.y); }
#else
#define RSQ_TREE(OUT) { \
    f16vec2 P0_[NT], P1_[NT]; \
    EACH_T(RSQ_TILE) \
    precise f16vec2 W00_ = (P0_[0] + P0_[2]) + (P0_[4] + P0_[6]), W01_ = (P1_[0] + P1_[2]) + (P1_[4] + P1_[6]); \
    precise f16vec2 W10_ = (P0_[1] + P0_[3]) + (P0_[5] + P0_[7]), W11_ = (P1_[1] + P1_[3]) + (P1_[5] + P1_[7]); \
    precise f16vec2 A0_ = W00_ + W10_, A1_ = W01_ + W11_; \
    precise f16vec2 U0_ = A0_ + UN16(SH16(A0_)), U1_ = A1_ + UN16(SH16(A1_)); \
    precise f16vec2 S_ = U0_ + U1_; \
    OUT = RSQ16(S_.x + S_.y); }
#endif
#define ZK(m) { \
    const bool up_ = hf != 0u; \
    const f16vec2 w0_ = f16vec2((m)[0], (m)[1]), w1_ = f16vec2((m)[2], (m)[3]); \
    const f16vec2 w2_ = f16vec2((m)[4], (m)[5]), w3_ = f16vec2((m)[6], (m)[7]); \
    const f16vec2 r0_ = UN16(SH16(up_ ? w0_ : w2_)), r1_ = UN16(SH16(up_ ? w1_ : w3_)); \
    const f16vec2 a_ = up_ ? r0_ : w0_, b_ = up_ ? w2_ : r0_, c_ = up_ ? r1_ : w1_, d_ = up_ ? w3_ : r1_; \
    (m)[0] = a_.x; (m)[1] = a_.y; (m)[2] = b_.x; (m)[3] = b_.y; (m)[4] = c_.x; (m)[5] = c_.y; (m)[6] = d_.x; (m)[7] = d_.y; }
#define RSQ_TILE(T) { \
    precise f16vec2 A_ = f16vec2(EV(T, 0), EV(T, 1)), B_ = f16vec2(EV(T, 2), EV(T, 3)); \
    precise f16vec2 C_ = f16vec2(EV(T, 4), EV(T, 5)), D_ = f16vec2(EV(T, 6), EV(T, 7)); \
    P0_[T] = (A_ * A_) + (B_ * B_); P1_[T] = (C_ * C_) + (D_ * D_); }

