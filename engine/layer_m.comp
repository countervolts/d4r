            f0[i_ + 4] = uintBitsToFloate4m3EXT(uint8_t(u1_ >> (8u * uint(i_))));
            f1[i_] = uintBitsToFloate4m3EXT(uint8_t(u2_ >> (8u * uint(i_))));
            f1[i_ + 4] = uintBitsToFloate4m3EXT(uint8_t(u3_ >> (8u * uint(i_))));
