#ifndef AMD_REGISTER_INPUT
    SYNC
#endif
#endif
    // ------------------------------------------------------------ norm 1: sum of squares, residual and h1
    FORW {
    WINV
#if EXPAND
    const uint lb0 = ((byr >> 1) * 4u + (bxr >> 1)) * S4 + ((byr & 1u) * 2u + (bxr & 1u)) * UC + ch8;
    const uint sb0 = (iy * uint(p.W) + ix) * UC + ch8;
#if defined(M_AMD_PACKED_SKIP) && KIND == 4
    B8 skip_[NT];
    [[unroll]] for (uint n_ = 0u; n_ < NT; ++n_) {
        const uint at_ = ((2u * n_ + hf) * uint(p.W) * uint(p.Hh) + iy * uint(p.W) + ix) * 2u;
        const fe4m3vec4 a_ = skip8.a[at_], b_ = skip8.a[at_ + 1u];
        skip_[n_][0] = a_.x; skip_[n_][1] = a_.y; skip_[n_][2] = a_.z; skip_[n_][3] = a_.w;
        skip_[n_][4] = b_.x; skip_[n_][5] = b_.y; skip_[n_][6] = b_.z; skip_[n_][7] = b_.w;
    }
#define XVAL(C) (float16_t(NEX[lb0 + (C)]) + float16_t(skip_[(C) / 16u][(C) % 16u]))
#else
#define XVAL(C) (float16_t(NEX[lb0 + (C)]) + float16_t(skb.a[sb0 + (C)]))
#endif
#elif defined(AMD_REGISTER_INPUT)
#define XVAL(C) float16_t(XREG_[w][(C) / 16u][(C) % 16u])
#elif KIND == 3
    const uint xb0 = (mt * 16u + row) * XS + ch8;
#define XVAL(C) X0S[xb0 + (C)]
#else
    const uint ib0 = (iy * uint(p.W) + ix) * UC + ch8;
#define XVAL(C) float16_t(inb.a[ib0 + (C)])
#endif
// The native's register element (tile T, half hf, element I) holds the natural channel tok_xnat(T, 8hf+I) =
// 16T + 8*((I>>2)&1) + 4hf + (I&3) (kernels/m/swin_tok.h tok_rsq on the register layout the input plane implies).
// This shader's own accumulators and A rows keep natural channels, so h1 and the residual use XVAL (the lane's
// own half); the norm tree, however, groups per the native element order, so it reads the absolute channel.
#if EXPAND
#define XVALN(C) (float16_t(NEX[(lb0 - ch8) + (C)]) + float16_t(skb.a[(sb0 - ch8) + (C)]))
#elif KIND == 3
#define XVALN(C) X0S[(xb0 - ch8) + (C)]
#else
#define XVALN(C) float16_t(inb.a[(iy * uint(p.W) + ix) * UC + (C)])
#endif
#if TEXL
#define EV(T, I) XVAL(16u * (T) + uint(I))         // natural order: the lane's own channels
#else
#define EV(T, I) XVALN(16u * (T) + 8u * ((uint(I) >> 2) & 1u) + 4u * hf + (uint(I) & 3u))
#endif
#ifdef M_AMD_NORM
    float sum0_ = 0.0, sum1_ = 0.0;
    for (uint t_ = 0u; t_ < NT; ++t_)
#ifdef M_AMD_NORM_DOT2
        for (uint i_ = 0u; i_ < 8u; i_ += 4u) {
            const f16vec2 a_ = f16vec2(XVAL(16u * t_ + i_), XVAL(16u * t_ + i_ + 1u));
            const f16vec2 b_ = f16vec2(XVAL(16u * t_ + i_ + 2u), XVAL(16u * t_ + i_ + 3u));
            sum0_ = amdDot2(a_, a_, sum0_); sum1_ = amdDot2(b_, b_, sum1_);
        }
#else
        for (uint i_ = 0u; i_ < 8u; i_ += 2u) {
            const float a_ = float(XVAL(16u * t_ + i_)), b_ = float(XVAL(16u * t_ + i_ + 1u));
            sum0_ = fma(a_, a_, sum0_); sum1_ = fma(b_, b_, sum1_);
        }
#endif
    const float sum_ = sum0_ + sum1_;
    const float rn = inversesqrt(sum_ + subgroupShuffleXor(sum_, 16u) + 0.0001220703125);
#else
    float16_t rn; RSQ_TREE(rn)
#endif
#undef EV
#define NM1(N) { \
    const uint wb = (p.o[0] + 16u * (N) + ch8) / 4u, bb = (p.o[1] + 16u * (N) + ch8) / 4u; \
    const f16vec4 g0 = w16.w[wb], g1 = w16.w[wb + 1u], d0 = w16.w[bb], d1 = w16.w[bb + 1u]; \
    const float16_t x0 = XVAL(16u * (N) + 0u), x1 = XVAL(16u * (N) + 1u), x2 = XVAL(16u * (N) + 2u), x3 = XVAL(16u * (N) + 3u); \
    const float16_t x4 = XVAL(16u * (N) + 4u), x5 = XVAL(16u * (N) + 5u), x6 = XVAL(16u * (N) + 6u), x7 = XVAL(16u * (N) + 7u); \
    res[N][0] = RADD(x0, d0.x); res[N][1] = RADD(x1, d0.y); \
    res[N][2] = RADD(x2, d0.z); res[N][3] = RADD(x3, d0.w); \
    res[N][4] = RADD(x4, d1.x); res[N][5] = RADD(x5, d1.y); \
    res[N][6] = RADD(x6, d1.z); res[N][7] = RADD(x7, d1.w); \
    H1N_1(N, rn) }
    EACH_T(NM1)
    }
#if KIND == 2 || (KIND == 3 && !defined(AMD_REGISTER_INPUT) && !defined(M_AMD_REGISTER_V)) || (KIND == 4 && defined(M_AMD_ALIAS_V8) && !defined(M_AMD_REGISTER_V))
    SYNC   // every wave has read the block's input (NEX, X0S): the V tiles take its place
#endif
    // ------------------------------------------------------------ attention, one head at a time
    for (uint hd = 0u; hd < uint(NH); ++hd)
    {
        const uint oq = p.o[4u + 4u * hd], ov = p.o[5u + 4u * hd], ob = p.o[6u + 4u * hd], ow = p.o[7u + 4u * hd];
        // Q of every window, then V of every window: each weight tile is loaded once for the wave's windows
        A8 QA_[WPW][2];
        {
            AC32 q[WPW][2];
            FORW { q[w][0] = AC32(0.0); q[w][1] = AC32(0.0); }
#define Q_G(A, B) { \
            const uint kt = A; \
            QW aq0, aq1; \
            LDQ(aq0, QOFF, kt, 32u, 0u); \
            LDQ(aq1, QOFF, kt + 1u, 32u, 0u); \
            FORW { K32F(q[w][0], aq0, h1[A], aq1, h1[B]) } \
            LDQ(aq0, QOFF, kt, 32u, 16u); \
            LDQ(aq1, QOFF, kt + 1u, 32u, 16u); \
            FORW { K32F(q[w][1], aq0, h1[A], aq1, h1[B]) } }
#ifdef L_HALF_INPUT
#define QOFF (49u + 2u * hd)
#else
#define QOFF oq
#endif
            EACH_T16(Q_G)
            FORW {
                for (uint m = 0u; m < 2u; ++m)
                {
#ifdef M_RELAXED
