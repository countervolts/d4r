        AC32 z0 = BIASA(p.o[61], 39, 0u, 32u), z1 = BIASA(p.o[61] + 16u, 39, 16u, 32u);
        { A8 a0, a1; LDA8(a0, p.o[60], 0u, 32u, 0u); LDA8(a1, p.o[60], 1u, 32u, 0u); K32F(z0, a0, f0, a1, f1) }
        { A8 a0, a1; LDA8(a0, p.o[60], 0u, 32u, 16u); LDA8(a1, p.o[60], 1u, 32u, 16u); K32F(z1, a0, f0, a1, f1) }
        B8 g0, g1;
#ifdef M_F32ACT
        for (int i = 0; i < 8; i += 2)
        {
            SATF2_(g0, i, max(vec2(z0[i], z0[i + 1]), vec2(0.0)))
            SATF2_(g1, i, max(vec2(z1[i], z1[i + 1]), vec2(0.0)))
