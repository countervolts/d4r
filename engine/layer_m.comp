shared floate4m3_t NB[32 * S4];             // 16 merged rows, preceded by 16 rows of slack for the gather
#endif
#if EXPAND
shared floate4m3_t NLI[16 * SLO];           // the block's 16 low-resolution tokens
shared floate4m3_t NEX[16 * S4];            // their expanded 4C columns
#endif
#if KIND == 3
const uint FS = 40u, XS = 40u;              // row strides of the feature and x0 images (32 + slack)
shared floate4m3_t FEW[64 * FS];            // the block's 64 pixels' feature slots, window-major (wave, token)
shared float16_t X0S[64 * XS];              // the embedding's output x0, the block's input
#endif
