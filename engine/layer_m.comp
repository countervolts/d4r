#else
        for (int i = 0; i < 8; ++i)
        {
            g0[i] = floate4m3_t(CL8(max(float16_t(z0[i]), float16_t(0.0))));
            g1[i] = floate4m3_t(CL8(max(float16_t(z1[i]), float16_t(0.0))));
