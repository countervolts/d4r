#version 460
// d4r engine, preset M (rrlite): one Swin block over 4x4-token windows, register-resident.
//
// The cooperative matrix is opaque in GLSL, but RADV's gfx1201 lowering has a fixed lane/slot <-> element
// mapping, the same for every 16x16x16 use. It was proven on this GPU with the probes in
// build/engine-quality/rm-probe (each lane writes its own slot values into an operand and the resulting image is
// read back):
//
//   RowMajor    sources and destinations are indexed [row][col]
//   ColumnMajor sources and destinations are indexed [col][row]
//   accumulator and B operand: element i of lane l is (row = 8*(l>>4) + i, col = l & 15)
//   A operand:                 element i of lane l is (row = l & 15,        col = 8*(l>>4) + i)
//
// Every product here is therefore weights x activations (A = weights, B = activations): a product's rows are the
// output channels and its columns the tokens, and the per-lane elements of a result ARE the per-lane elements of
// the next product's B operand. Cooperative-matrix subscripts read and write those elements in place, so the
// attention and the MLP chain never leave the registers. Only the patch expand (decoders) and the patch merge
// (encoders) move data between waves, and only those use shared memory and a workgroup barrier.
//
// NVIDIA's arithmetic (the semantics of kernels/m/swin_common.h K32_MIX, which the captured launches agree with)
// rounds the accumulator to binary16 after every logical 32 products; the 16x16x16 cells have no K32 form, so a
// logical k32 is two K16 steps summed in f32 and rounded once. RADV folds a register-only f32 -> f16 -> f32
// conversion away, so the rounding of P + the previous accumulator passes through a per-invocation binary16
// scratch slot (no cross-lane traffic: a subgroup memory barrier is enough). The tile loops are written out one
// tile at a time because a cooperative matrix indexed by a loop variable is not a register any more.
//
// The two norms do NOT use the natural element order of this shader's accumulators: the native register element
// (tile T, half hf, element I) holds the natural channel tok_xnat(T, 8hf+I) = 16T + 8*((I>>2)&1) + 4hf + (I&3),
// and tok_rsq's summation tree groups the lanes' squares in that order. Norm 1 therefore reads the input at that
// channel (XVALN, the absolute one, not the lane's own half) and norm 2 rebuilds the native order from the
// accumulator registers with a pair-aligned half-wave exchange. Without this the ten layers reach only 41-46 dB
// against the capture even though every product, weight map and bias is already the native one.
//
// Build-time shape: C, NH, KIND (0 plain, 1 encoder with 2x2 patch merge, 2 decoder with patch expand + skip,
// 3 preset L's input stage, 4 preset L's expansion stage), XC (merged channels or low-resolution channels). One
// workgroup is an 8x8-token block: four waves, one per 4x4-token window. Bindings 0-6 and the parameter block are
// the same for every kind; the FP8 weight matrices are the packed fixed-16 tiles of test_m.pack8 (the f16 vectors
// stay row-major).
//
// Preset L (L_NOTES.md) runs a C 32, 2-head block of this shape at render-pixel resolution in its input and
// expansion stages, where M has single folded matrix products:
//   KIND 3 (rrlite_enc0_4x4_*): enc0_features.glsl's 32 FP8 feature slots per pixel, an embedding
//          x0 = W2 q8(relu(W1 f + b1)) + b2 (32 -> 32 -> 32), the block, its FP8 output (dec0's skip input) and a
//          patch merge to 64 channels at half resolution (the network's input). Weights o[60..63]: W1, b1, W2, b2.
//   KIND 4 (rrlite_dec0_4x4): the patch expand of the network's 64-channel output plus that skip input, the
//          block, and the reconstruction's per-pixel inputs from its f16 output (no FP8 rounding, no history).
// TEXL selects the arithmetic of ZLUDA's lowering of NVIDIA's PTX (kernels/tex/swin_tex.h): the bias or previous
// accumulator enters the first of a k32 step's two products as C, the norms sum in natural channel order, the P V
// product's keys take ZLUDA's K slots, and the reciprocal square root is the hardware approximation. compile_m.py
// builds every layer of M and L with it: the chained network and the whole frame are then byte-identical to the CUDA
// backend running NVIDIA's translated kernels (L_NOTES.md). Without it the layers reproduce d4r's native accuracy
// kernels (K32_MIX) instead, which drift from that reference through the FP8 tube.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_float_e4m3 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#ifdef M_SCALAR_WAVE
#extension GL_KHR_shader_subgroup_ballot : require
#endif
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#ifdef M_AMD_EMBED_QUANT16
#extension GL_EXT_spirv_intrinsics : require
spirv_instruction(id = 116) float amdQuantizeHalf(float value);
#endif
#ifdef M_AMD_NORM_DOT2
#extension GL_EXT_spirv_intrinsics : require
spirv_instruction(extensions = ["SPV_VALVE_mixed_float_dot_product"], capabilities = [6912], id = 6916)
float amdDot2(f16vec2 a, f16vec2 b, float accumulator);
#endif
// WPW: 4x4-token windows per wave (1, 2 or 4). A workgroup is always one 8x8-token block of four windows; with
// WPW > 1 a wave walks WPW of them and every weight tile is loaded once for all of them (a window reads the whole
// layer's weights, which is a third of the network's time with one window per wave). Values do not change.
#ifndef WPW
#define WPW 1
#endif
#if WPW > 2 && KIND >= 3
#error layer_m.comp: L's input and expansion stages handle their 64 pixels one per invocation (WPW <= 2)
#endif
#if defined(M_L_HEAD16) && KIND == 4
#if C != 32 || !defined(M_RES32) || defined(L_DUMP)
#error M_L_HEAD16 needs C32, M_RES32 and the specialized output head (no L_DUMP)
#endif
#define L_HEAD16
#endif
layout(local_size_x = 128 / WPW) in;
// o: 0 g1, 1 bo, 2 g2, 3 b2 (f16); per head h at 4 + 4h: q, v (FP8), bias (f16), wo (FP8);
//    per MLP chunk c at 20 + 3c: w1 (FP8), b1 (f16), w2 (FP8); 68, 69: merge or expand weights (FP8) and bias (f16)
layout(set = 0, binding = 0, std430) readonly buffer Pb { int W; int Hh; int sx; int sy; uint o[72]; } p;
layout(set = 0, binding = 1, std430) readonly buffer W8 { floate4m3_t w[]; } w8;
layout(set = 0, binding = 2, std430) readonly buffer W16 { f16vec4 w[]; } w16;
#ifdef M_BIAS32
// M_BIAS32 (with M_F32ACT): f32 copies of the bias tiles in the same buffer, at o[32 + c] (the MLP's chunk c), o[36 + h]
// (head h's position bias), o[38] (the merge or expansion), o[39], o[40] (the embedding's), in floats
layout(set = 0, binding = 2, std430) readonly buffer W32 { vec4 w[]; } w32;
#endif
layout(set = 0, binding = 3, std430) readonly buffer Ib { floate4m3_t a[]; } inb;      // [H][W][C]; decoders: [H/2][W/2][XC]
layout(set = 0, binding = 4, std430) readonly buffer Sb { floate4m3_t a[]; } skb;      // decoders: skip [H][W][C]
#if defined(M_AMD_PACKED_SKIP) && KIND == 4
layout(set = 0, binding = 4, std430) readonly buffer Skip8 { fe4m3vec4 a[]; } skip8;
#endif
#if KIND == 4 && defined(L_DUMP)
layout(set = 0, binding = 5, std430) buffer O0 { float16_t a[]; } ldump;              // debug: the head's inputs [H][W][C]
#elif defined(M_AMD_PACKED_SKIP) && KIND == 3
layout(set = 0, binding = 5, std430) buffer SkipOut8 { fe4m3vec4 a[]; } skipOut8;
#else
layout(set = 0, binding = 5, std430) buffer O0 { floate4m3_t a[]; } out0;              // [H][W][C]
#endif
layout(set = 0, binding = 6, std430) buffer O1 { floate4m3_t a[]; } out1;              // encoders: merged [H/2][W/2][XC]
#ifndef TEXL
#define TEXL 0
#endif
// PLANES (KIND 3 and 4): the half-resolution tokens in NGX's layout, planes of 32 channels ([XC/32][H/2][W/2][32]),
// for a network that runs outside the engine (the native HIP layers)
#ifndef PLANES
#define PLANES 0
#endif
#if KIND == 3
// the input stage's parameter block (MEnc0Params; W, Hh above are the token pixel grid)
layout(set = 0, binding = 7, std430) readonly buffer Ep
{
    ivec2 size, shift, tok;
    vec2 jitter, prevJitter;
    vec2 mvScale, mvOffs;
    vec2 rnd2hi, hi2rnd;
    vec2 hiSize;
    float changeScale, changeGain;
    uint depthFlag, reset, frame;
    float expo, expoPrev;
    float halfInvX, halfInvY, renderInvX, renderInvY;
} ep;
layout(set = 0, binding = 8) uniform sampler2D colorTex;
layout(set = 0, binding = 9) uniform sampler2D motionTex;
layout(set = 0, binding = 10) uniform sampler2D depthTex;
layout(set = 0, binding = 11) uniform sampler2D prevMvTex;     // candidate A of the previous frame, bilinear
layout(set = 0, binding = 12) uniform sampler2D halfTex;       // half-resolution previous result, bilinear
layout(set = 0, binding = 13) uniform sampler2D featTex;       // recurrent feature, bilinear
layout(set = 0, binding = 14, rg16f) uniform writeonly image2D mvAOut;
layout(set = 0, binding = 15, rg16f) uniform writeonly image2D mvBOut;
layout(set = 0, binding = 16, rg16f) uniform writeonly image2D mvCOut;
layout(set = 0, binding = 17, std430) readonly buffer Noise { uint16_t n[]; } noise;  // 8 x 16 x 16
#define EP ep
#include "enc0_features.glsl"
#undef EP
#if defined(M_AMD_SPLIT_FEATURES) || defined(M_AMD_FEATURE_PASS)
layout(set = 0, binding = 18, std430) buffer PreparedFeatures { fe4m3vec4 a[]; } preparedFeatures;
#endif
#endif
#if KIND == 4
#include "normalized_store.glsl"
#include "round_half.glsl"
// the expansion stage's parameter block (MDec0Params): render size, the covariance's sigma and rho
layout(set = 0, binding = 7, std430) readonly buffer Dp
{
    ivec2 size;
    int tokW; uint reset;
    vec2 rndOffs, rnd2hi, hiSize, histOffs;
    float sigma, rho;
    vec2 renderInv;
} dp;
layout(set = 0, binding = 8, rgba8_snorm) uniform writeonly image2D featOut;
layout(set = 0, binding = 9, rgba8) uniform writeonly image2D gateOut;
layout(set = 0, binding = 10, rgba8) uniform writeonly image2D mixOut;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D covOut;
#endif
#define ACC coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define HAC coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define A8 coopmat<floate4m3_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define B8 coopmat<floate4m3_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define A16 coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define B16 coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#if defined(M_AMD_PACKED_SKIP) && (!defined(M_AMD_NORM) || !defined(M_RES32) || C != 32)
#error packed skip is a paired C32 outer-stage ABI requiring natural FP32 normalization
#endif
#ifdef M_AMD_REGISTER_V
#if !defined(M_AMD_PV8) || !defined(M_F32ACT) || defined(M_L_HALF_INPUT)
#error register V requires FP8 probability/value and FP32 accumulators
#endif
// The same physical fragments change matrix roles without a lane exchange:
// B(channel,token) -> A(token,channel), A(out,in) -> B(in,out).
A8 amdAsA(B8 b) { A8 a; for (int i = 0; i < 8; ++i) a[i] = b[i]; return a; }
B8 amdAsB(A8 a) { B8 b; for (int i = 0; i < 8; ++i) b[i] = a[i]; return b; }
#endif
#if defined(M_AMD_REGISTER_INPUT) && KIND == 3
#if C != 32 || WPW != 2 || !defined(M_AMD_NORM) || !defined(M_RES32)
#error register input requires relaxed C32 natural normalization and two windows per wave
#endif
#define AMD_REGISTER_INPUT
#endif
// AMD quality-budget path: native arithmetic/layouts; evaluated by final RGB
// PSNR against a reference rather than the reference's intermediate rounding.
#if defined(M_AMD_HEAD) || defined(M_AMD_NORM) || defined(M_AMD_SOFTMAX) || defined(M_AMD_PV8) || defined(M_AMD_GELU)
#ifndef M_RELAXED
#error AMD quality-budget options require M_RELAXED
#endif
#endif
#ifdef M_AMD_PV8
// Dedicated FP8 transpose storage: 8 tiles, 256 bytes per tile. Keep V in
// FP8 instead of materializing half, then running the lower-throughput half WMMA.
#if !defined(M_AMD_ALIAS_V8) && !defined(M_AMD_REGISTER_V)
shared floate4m3_t AMD_V8[8 * 256];
#define AMD_V8_UNIT 1u
#endif
#endif
#if defined(M_L_HALF_INPUT) && KIND >= 3
#if C != 32 || !defined(M_RELAXED) || !defined(M_LDAU)
#error M_L_HALF_INPUT is an experimental relaxed C32 path requiring M_LDAU
#endif
#define L_HALF_INPUT
#define QW A16
#define HOP B16
// Slots 49..52: Q/V per head, 53..56: fc1 per chunk. They contain
// exactly decoded FP8 weights in the same fixed-16 layout, as binary16.
#define LDQ(dst, slot, ks, stride, moff) { \
    const uint at_ = (p.o[slot] + 256u * (uint(ks) * (uint(stride) / 16u) + uint(moff) / 16u)) / 4u + ldaLane; \
    const f16vec4 a_ = w16.w[at_], b_ = w16.w[at_ + 1u]; \
    (dst)[0] = a_.x; (dst)[1] = a_.y; (dst)[2] = a_.z; (dst)[3] = a_.w; \
    (dst)[4] = b_.x; (dst)[5] = b_.y; (dst)[6] = b_.z; (dst)[7] = b_.w; }
#else
#define QW A8
#define HOP B8
#define LDQ(dst, slot, ks, stride, moff) LDA8(dst, slot, ks, stride, moff)
#endif
#define RM gl_CooperativeMatrixLayoutRowMajor
#define CM gl_CooperativeMatrixLayoutColumnMajor
const uint UC = uint(C), NT = uint(C) / 16u, UXC = uint(XC);
const uint SLO = UXC + 8u;                  // row stride of the low-resolution token image
const uint S4 = 4u * UC + 8u;               // row stride of the 4C rows (patch expand / merge)
const uint VWD = 16u;                       // row width of the per-wave V transpose buffer, in f16
int mirror(int v, int n) { v = abs(v); return min(v, 2 * n - 2 - v); }
#define Q16(v) float16_t(v)
#define CL8(v) clamp(v, float16_t(-448.0), float16_t(448.0))
const float16_t MCL = float16_t(6.2831855);
// NVIDIA's accumulator rounding: one binary16 rounding of the whole tile after every logical 32 products.
// RADV folds a register-only f32->f16->f32 conversion away (measured: half of all values and every tie
// midpoint unchanged), so the rounding has to pass through binary16 memory. Each invocation owns 8 halves of
// its own scratch: no cross-lane traffic, so a subgroup fence is enough (no workgroup barrier).
// M_RELAXED (M_DEFS=-DM_RELAXED for compile_m.py): this GPU's own arithmetic instead. The accumulator stays f32
// across the 32-deep steps and is rounded once where it is used, with no scratch round trip; a layer is then no
// longer bit-identical to NVIDIA's kernel (FP8 codes flip by one step here and there), which two NVIDIA setups
// are not either (engine/rr/README.md).
#ifdef M_RELAXED
#define R16(m) { }
#define K32H(dst, a0, b0, a1, b1) { \
    ACC P_ = coopMatMulAdd((a1), (b1), coopMatMulAdd((a0), (b0), ACC(dst))); \
    (dst)[0] = float16_t(P_[0]); (dst)[1] = float16_t(P_[1]); (dst)[2] = float16_t(P_[2]); (dst)[3] = float16_t(P_[3]); \
    (dst)[4] = float16_t(P_[4]); (dst)[5] = float16_t(P_[5]); (dst)[6] = float16_t(P_[6]); (dst)[7] = float16_t(P_[7]); }
#else
shared f16vec4 RS[128 * 2];
#define R16(m) { \
    RS[gl_LocalInvocationID.x * 2u + 0u] = f16vec4(float16_t((m)[0]), float16_t((m)[1]), float16_t((m)[2]), float16_t((m)[3])); \
    RS[gl_LocalInvocationID.x * 2u + 1u] = f16vec4(float16_t((m)[4]), float16_t((m)[5]), float16_t((m)[6]), float16_t((m)[7])); \
    subgroupMemoryBarrierShared(); \
    const f16vec4 r0_ = RS[gl_LocalInvocationID.x * 2u + 0u], r1_ = RS[gl_LocalInvocationID.x * 2u + 1u]; \
    (m)[0] = float(r0_.x); (m)[1] = float(r0_.y); (m)[2] = float(r0_.z); (m)[3] = float(r0_.w); \
    (m)[4] = float(r1_.x); (m)[5] = float(r1_.y); (m)[6] = float(r1_.z); (m)[7] = float(r1_.w); }
#endif
// one logical k32, exactly as the native K32_MIX: P = A0*B0 + A1*B1 from a zero seed, then one binary16
// rounding of P + the previous accumulator (the native v_fma_mix), through the scratch so it is not folded.
// Packed fixed-16 weight tiles (test_m.pack8): matrix W[K][N] as [K/16][N/16][N16][K16], so one 16x16 A tile
// is 256 contiguous bytes at base + 256*(kTile*(N/16) + nOffset/16), read RowMajor with stride 16. Same A
// operand values as the old plain W[K][N] ColumnMajor stride-N load, but a plain (non-transposed) load.
#ifdef M_LDAU
// M_LDAU: the same operand read as this lane's own 8 bytes (row l & 15, columns 8 (l >> 4) ..: two dwords at a lane
// offset computed once), so each tile costs one address add instead of the cooperative load's per-load lane arithmetic
layout(set = 0, binding = 1, std430) readonly buffer W8V { fe4m3vec4 w[]; } w8v;
uint ldaLane;                               // the lane's dword in a tile: 4 (l & 15) + 2 (l >> 4), set first in main
#define LDA8(dst, base, ks, stride, moff) { \
    const uint i_ = ((base) + 256u * (uint(ks) * (uint(stride) / 16u) + (uint(moff) / 16u))) / 4u + ldaLane; \
    const fe4m3vec4 u0_ = w8v.w[i_], u1_ = w8v.w[i_ + 1u]; \
    (dst)[0] = u0_.x; (dst)[1] = u0_.y; (dst)[2] = u0_.z; (dst)[3] = u0_.w; \
    (dst)[4] = u1_.x; (dst)[5] = u1_.y; (dst)[6] = u1_.z; (dst)[7] = u1_.w; }
#else
#define LDA8(dst, base, ks, stride, moff) coopMatLoad((dst), w8.w, (base) + 256u * (uint(ks) * (uint(stride) / 16u) + (uint(moff) / 16u)), 16u, RM)
#endif

#if defined(M_RELAXED)
#elif TEXL
// ZLUDA's lowering of m16n8k32 (K32_NO_MIX): the accumulator enters the first product as C, f32 throughout the step,
// one binary16 rounding at its end
#define K32H(dst, a0, b0, a1, b1) { \
    ACC P_ = coopMatMulAdd((a1), (b1), coopMatMulAdd((a0), (b0), ACC(dst))); \
    RS[gl_LocalInvocationID.x * 2u + 0u] = f16vec4(float16_t(P_[0]), float16_t(P_[1]), float16_t(P_[2]), float16_t(P_[3])); \
    RS[gl_LocalInvocationID.x * 2u + 1u] = f16vec4(float16_t(P_[4]), float16_t(P_[5]), float16_t(P_[6]), float16_t(P_[7])); \
    subgroupMemoryBarrierShared(); \
    const f16vec4 u0_ = RS[gl_LocalInvocationID.x * 2u + 0u], u1_ = RS[gl_LocalInvocationID.x * 2u + 1u]; \
    (dst)[0] = u0_.x; (dst)[1] = u0_.y; (dst)[2] = u0_.z; (dst)[3] = u0_.w; \
    (dst)[4] = u1_.x; (dst)[5] = u1_.y; (dst)[6] = u1_.z; (dst)[7] = u1_.w; }
#else
#define K32H(dst, a0, b0, a1, b1) { \
    ACC P_ = coopMatMulAdd((a1), (b1), coopMatMulAdd((a0), (b0), ACC(0.0))); \
    RS[gl_LocalInvocationID.x * 2u + 0u] = f16vec4( \
        float16_t(P_[0] + float((dst)[0])), float16_t(P_[1] + float((dst)[1])), \
        float16_t(P_[2] + float((dst)[2])), float16_t(P_[3] + float((dst)[3]))); \
    RS[gl_LocalInvocationID.x * 2u + 1u] = f16vec4( \
        float16_t(P_[4] + float((dst)[4])), float16_t(P_[5] + float((dst)[5])), \
        float16_t(P_[6] + float((dst)[6])), float16_t(P_[7] + float((dst)[7]))); \
    subgroupMemoryBarrierShared(); \
    const f16vec4 u0_ = RS[gl_LocalInvocationID.x * 2u + 0u], u1_ = RS[gl_LocalInvocationID.x * 2u + 1u]; \
    (dst)[0] = u0_.x; (dst)[1] = u0_.y; (dst)[2] = u0_.z; (dst)[3] = u0_.w; \
    (dst)[4] = u1_.x; (dst)[5] = u1_.y; (dst)[6] = u1_.z; (dst)[7] = u1_.w; }
#endif
// a tiled f16 vector (16 equal rows) as the initial value of an accumulator whose rows are its channels
HAC bias16(uint off, uint stride) { HAC b; coopMatLoad(b, w16.w, off / 4u, stride / 4u, CM); return b; }
#ifdef M_BIAS32
#if !defined(M_F32ACT) || C != 32
#error layer_m.comp: M_BIAS32 needs M_F32ACT and C 32 (its slots follow the four MLP chunks)
#endif
ACC bias32(uint off, uint stride) { ACC b; coopMatLoad(b, w32.w, off / 4u, stride / 4u, CM); return b; }
// the bias of a product with an f32 accumulator: its f32 copy (slot o[s32], channel c) or the binary16 tile at e16
#define BIASA(e16, s32, c, stride) bias32(p.o[s32] + (c), stride)
#elif defined(M_F32ACT)
#define BIASA(e16, s32, c, stride) ACC(bias16(e16, stride))
#else
#define BIASA(e16, s32, c, stride) bias16(e16, stride)
#endif
#ifdef M_RELAXED
// straight from f32 into FP8, two elements per saturating conversion; the activation in f32 as well
// M_LLPC_SAT (compile_m.py, preset L's *_llpc.spv for AMD's Windows driver): both as a clamp to +-448 and the plain
// conversion. LLPC keeps saturatedConvertEXT's NaN-preserving clamp (a clamp, a class test and a select per element)
// and FINITE's compare and select, each select waiting on its compare's VCC. The clamp gives the same code for every
// finite value and infinity; a NaN gives +-448 instead of the NaN code.
#ifdef M_LLPC_SAT
#define SAT2_(dst, i, v) { const fe4m3vec2 t_ = fe4m3vec2(clamp(v, vec2(-448.0), vec2(448.0))); (dst)[i] = t_.x; (dst)[(i) + 1] = t_.y; }
#else
#define SAT2_(dst, i, v) { fe4m3vec2 t_; saturatedConvertEXT(t_, (v)); (dst)[i] = t_.x; (dst)[(i) + 1] = t_.y; }
#endif
#define MK8_F8(dst, a) { SAT2_(dst, 0, vec2((a)[0], (a)[1])) SAT2_(dst, 2, vec2((a)[2], (a)[3])) SAT2_(dst, 4, vec2((a)[4], (a)[5])) SAT2_(dst, 6, vec2((a)[6], (a)[7])) }
// SATF2_: the same for a value that is never infinite, written as "an infinity becomes NaN, then saturate", which RADV
// turns into the hardware conversion with FP16_OVFL instead of a NaN-preserving clamp per element and the conversion
// (f2e4m3fn_satfn; the same result for every finite value and NaN, engine/rr/rr_exact.glsl FINITE). Used for the
// attention's f32 sums of FP8 products (MK8_F8F) and the normalised tokens: the norm sums the squares of the very
// values it scales, so an infinite channel makes the reciprocal 0 and the product NaN, never infinite. The binary16
// accumulators (q, the MLP, the expansion, the residual) can overflow to infinity and keep SAT2_.
vec2 finite2_(vec2 v) { return vec2(isinf(v.x) ? uintBitsToFloat(0x7fc00000u) : v.x, isinf(v.y) ? uintBitsToFloat(0x7fc00000u) : v.y); }
// SATN2_: SATF2_ as written, in every build: the normalised tokens, which are NaN by design where a channel is
// infinite. Under M_LLPC_SAT these also keep LLPC's FP16_OVFL writes ahead of the binary16 arithmetic that follows,
// which the images depend on (with every conversion clamped, 8 of 29 MB of a 720p -> 1440p frame changed).
#define SATN2_(dst, i, v) { fe4m3vec2 t_; saturatedConvertEXT(t_, finite2_(v)); (dst)[i] = t_.x; (dst)[(i) + 1] = t_.y; }
#ifdef M_LLPC_SAT
#define SATF2_ SAT2_
#else
#define SATF2_ SATN2_
#endif
#define MK8_F8F(dst, a) { SATF2_(dst, 0, vec2((a)[0], (a)[1])) SATF2_(dst, 2, vec2((a)[2], (a)[3])) SATF2_(dst, 4, vec2((a)[4], (a)[5])) SATF2_(dst, 6, vec2((a)[6], (a)[7])) }
#ifdef M_AMD_GELU
#ifndef M_AMD_GELU_SLOPE
#define M_AMD_GELU_SLOPE 0.28125
#endif
// Hard GELU: one FMA, clamp and multiply, avoiding abs and the second FMA.
// This changes the activation; quality must be measured on the final sequence.
#define GELU2_(dst, i, h) { const vec2 x_ = vec2((h)[i], (h)[(i) + 1]); \
    GSAT2_(dst, i, x_ * clamp(fma(x_, vec2(M_AMD_GELU_SLOPE), vec2(0.5)), vec2(0.0), vec2(1.0))) }
#else
#define GELU2_(dst, i, h) { const vec2 x_ = vec2((h)[i], (h)[(i) + 1]); const vec2 y_ = clamp(x_, vec2(-2.0), vec2(2.0)); \
    const vec2 g_ = fma(y_, fma(-abs(y_), vec2(0.08108133), vec2(0.41216981)), vec2(0.5)); GSAT2_(dst, i, x_ * g_) }
#endif
#define GELU8(dst, h) { GELU2_(dst, 0, h) GELU2_(dst, 2, h) GELU2_(dst, 4, h) GELU2_(dst, 6, h) }
#else
#ifdef M_F32ACT
#error layer_m.comp: M_F32ACT needs M_RELAXED
#endif
#define MK8_F8(dst, a) { \
    const float16_t q0_ = CL8(Q16((a)[0])), q1_ = CL8(Q16((a)[1])), q2_ = CL8(Q16((a)[2])), q3_ = CL8(Q16((a)[3])); \
    const float16_t q4_ = CL8(Q16((a)[4])), q5_ = CL8(Q16((a)[5])), q6_ = CL8(Q16((a)[6])), q7_ = CL8(Q16((a)[7])); \
    (dst)[0] = floate4m3_t(q0_); (dst)[1] = floate4m3_t(q1_); (dst)[2] = floate4m3_t(q2_); (dst)[3] = floate4m3_t(q3_); \
    (dst)[4] = floate4m3_t(q4_); (dst)[5] = floate4m3_t(q5_); (dst)[6] = floate4m3_t(q6_); (dst)[7] = floate4m3_t(q7_); }
#define MK8_F8F MK8_F8
#endif
// M_F32ACT (part of M_RELAXED): the products whose only use is an FP8 conversion (Q, the MLP's hidden layer, the
// expansion, the embedding, the merge) keep f32 accumulators (AC32 / K32F) and convert with SATF2_. RADV already
// drops the binary16 rounding between such a product and its conversion, but then clamps every element NaN-preserving
// (v_minimummaximum_f32) for an infinity that an f32 sum of FP8 products cannot be: SATF2_ makes that one conversion.
#ifdef M_F32ACT
#define AC32 ACC
#define K32F(dst, a0, b0, a1, b1) { (dst) = coopMatMulAdd((a1), (b1), coopMatMulAdd((a0), (b0), (dst))); }
#define MK8_A(dst, a) MK8_F8F(dst, a)
#define GSAT2_ SATF2_
#else
#define AC32 HAC
#define K32F K32H
#define MK8_A(dst, a) MK8_F8(dst, a)
#define GSAT2_ SAT2_
#endif
// the normalised tokens into FP8 (inside NM1 / N2: x0..x7 the token, g0 / g1 the gains)
#define H1N_FREE(N, r_) { const float f_ = float(r_); \
        SATN2_(h1[N], 0, vec2(x0, x1) * f_) SATN2_(h1[N], 2, vec2(x2, x3) * f_) \
        SATN2_(h1[N], 4, vec2(x4, x5) * f_) SATN2_(h1[N], 6, vec2(x6, x7) * f_) }
#ifdef L_HALF_INPUT
#define H1N(N, r_) { const f16vec2 rr_ = f16vec2(float16_t(r_)); \
    const f16vec2 a_ = f16vec2(x0, x1) * (rr_ * g0.xy), b_ = f16vec2(x2, x3) * (rr_ * g0.zw); \
    const f16vec2 c_ = f16vec2(x4, x5) * (rr_ * g1.xy), d_ = f16vec2(x6, x7) * (rr_ * g1.zw); \
    h1[N][0] = a_.x; h1[N][1] = a_.y; h1[N][2] = b_.x; h1[N][3] = b_.y; \
    h1[N][4] = c_.x; h1[N][5] = c_.y; h1[N][6] = d_.x; h1[N][7] = d_.y; }
#elif defined(M_RELAXED)
#define H1N(N, r_) { const float f_ = float(r_); \
        SATN2_(h1[N], 0, vec2(x0, x1) * (f_ * vec2(g0.xy))) SATN2_(h1[N], 2, vec2(x2, x3) * (f_ * vec2(g0.zw))) \
        SATN2_(h1[N], 4, vec2(x4, x5) * (f_ * vec2(g1.xy))) SATN2_(h1[N], 6, vec2(x6, x7) * (f_ * vec2(g1.zw))) }
#else
#define H1N(N, r_) { \
        h1[N][0] = floate4m3_t(CL8(x0 * float16_t(r_ * g0.x))); h1[N][1] = floate4m3_t(CL8(x1 * float16_t(r_ * g0.y))); \
        h1[N][2] = floate4m3_t(CL8(x2 * float16_t(r_ * g0.z))); h1[N][3] = floate4m3_t(CL8(x3 * float16_t(r_ * g0.w))); \
        h1[N][4] = floate4m3_t(CL8(x4 * float16_t(r_ * g1.x))); h1[N][5] = floate4m3_t(CL8(x5 * float16_t(r_ * g1.y))); \
        h1[N][6] = floate4m3_t(CL8(x6 * float16_t(r_ * g1.z))); h1[N][7] = floate4m3_t(CL8(x7 * float16_t(r_ * g1.w))); }
#endif
#if defined(M_AMD_FOLDED_NORM) || (KIND == 3 && defined(M_AMD_FOLD_ENC_N1)) || (KIND == 4 && defined(M_AMD_FOLD_DEC_N1))
#define H1N_1 H1N_FREE
#else
#define H1N_1 H1N
#endif
#if defined(M_AMD_FOLDED_NORM) || (KIND == 3 && defined(M_AMD_FOLD_ENC_N2)) || (KIND == 4 && defined(M_AMD_FOLD_DEC_N2))
#define H1N_2 H1N_FREE
#else
#define H1N_2 H1N
