    const uint bxr = 4u * (mt & 1u) + (row & 3u), byr = 4u * (mt >> 1) + (row >> 2); \
    const int tx = X0 + int(bxr), ty = Y0 + int(byr); \
    const bool inside = ty >= 0 && ty < p.Hh && tx >= 0 && tx < p.W; \
    const uint iy = uint(mirror(ty, p.Hh)), ix = uint(mirror(tx, p.W));
    // the residual stream: rows are channels, columns are tokens. M_RES32 (part of M_RELAXED, implies M_RESIDUAL_F32):
    // f32 for the whole block, so the output projection, the MLP and the norm-2 sums convert nothing; norm 2's sum of
    // squares is then an f32 sum (no binary16 tree) and the residual adds take their f16 operands into f32 (v_fma_mix)
#ifdef M_RES32
#if !defined(M_RELAXED) || !defined(M_RESIDUAL_F32)
#error layer_m.comp: M_RES32 needs M_RELAXED and M_RESIDUAL_F32
#endif
#define RADD(a, b) (float(a) + float(b))
#define K32RES K32F
    ACC RES_[WPW][NT];
#else
#define RADD(a, b) float16_t((a) + (b))
#define K32RES K32H
    HAC RES_[WPW][NT];
#endif
    HOP H1_[WPW][NT];                           // the normalised activation, the K operand of every product
#define res RES_[w]
#define h1 H1_[w]
    // ------------------------------------------------------------ patch expand: x0 = q8(E) + skip
#if EXPAND
#ifdef M_L_EXPAND_DIRECT
    // Read matrix operands directly from the external token layout. Each wave
    // reuses the operands for all its windows; no cooperative LDS copy/barrier.
    const uint lowToken = uint(mirror((Y0 >> 1) + int(row >> 2), p.Hh / 2) * (p.W / 2) +
                               mirror((X0 >> 1) + int(row & 3u), p.W / 2));
    B8 LOW_[XC / 16];
    [[unroll]] for (uint kt = 0u; kt < UXC / 16u; ++kt) directLow(LOW_[kt], kt, lowToken, hf);
#else
    FORW {
        WINV
        const uint W2 = uint(p.W) / 2u, H2 = uint(p.Hh) / 2u, part = UXC / 8u, c0 = (mt * 2u + hf) * part;
        const uint lt = uint(mirror((Y0 >> 1) + int(row >> 2), int(H2)) * int(W2) + mirror((X0 >> 1) + int(row & 3u), p.W / 2));
        // unrolled, so that a lane's loads are all in flight before the first store waits for one
#if PLANES
        [[unroll]] for (uint i = 0u; i < part; ++i) { const uint c = c0 + i; NLI[row * SLO + c] = inb.a[((c >> 5) * H2 * W2 + lt) * 32u + (c & 31u)]; }
#else
        [[unroll]] for (uint i = 0u; i < part; ++i) { const uint c = c0 + i; NLI[row * SLO + c] = inb.a[lt * UXC + c]; }
#endif
    }
    SYNC
#endif
    FORW {
        WINV
        // this wave computes sub-position mt of every low-resolution token's 4C columns
        AC32 ef[NT];
#define EF_INIT(N) ef[N] = BIASA(p.o[69] + 16u * (mt * NT + (N)), 38, 16u * (mt * NT + (N)), 4u * UC);
#define EF_K32(N) { A8 xa0, xa1; \
    LDA8(xa0, p.o[68], kt, 4u * UC, 16u * (mt * NT + (N))); \
    LDA8(xa1, p.o[68], kt + 1u, 4u * UC, 16u * (mt * NT + (N))); \
    K32F(ef[N], xa0, b0, xa1, b1) }
#define EF_STORE(N) { A8 ey; MK8_A(ey, ef[N]); coopMatStore(ey, NEX, mt * UC + 16u * (N), S4, RM); }
        EACH_T(EF_INIT)
        for (uint kt = 0u; kt < UXC / 16u; kt += 2u)
        {
            B8 b0, b1;
#ifdef M_L_EXPAND_DIRECT
            b0 = LOW_[kt]; b1 = LOW_[kt + 1u];
#else
            coopMatLoad(b0, NLI, kt * 16u, SLO, CM);
