            QA_[w][m][0] = floate4m3_t(q0); QA_[w][m][1] = floate4m3_t(q1);
            QA_[w][m][2] = floate4m3_t(q2); QA_[w][m][3] = floate4m3_t(q3);
            QA_[w][m][4] = floate4m3_t(q4); QA_[w][m][5] = floate4m3_t(q5);
            QA_[w][m][6] = floate4m3_t(q6); QA_[w][m][7] = floate4m3_t(q7);
#endif
                }
            }
        }
#ifdef M_AMD_REGISTER_V
        // Compute V transposed by reversing GEMM operand roles. Its accumulator
        // layout IS the next product's A layout: quantize in place, no LDS
        // transpose, stores, loads or synchronization between the products.
        A8 VREG_[WPW][2];
        [[unroll]] for (uint vn_ = 0u; vn_ < 2u; ++vn_) {
            ACC vv_[WPW];
            FORW { vv_[w] = ACC(0.0); }
#define VR_G(A, B) { \
            A8 wa0_, wa1_; \
            LDA8(wa0_, ov, A, 32u, 16u * vn_); LDA8(wa1_, ov, B, 32u, 16u * vn_); \
            const B8 wb0_ = amdAsB(wa0_), wb1_ = amdAsB(wa1_); \
            FORW { const A8 ha0_ = amdAsA(h1[A]), ha1_ = amdAsA(h1[B]); \
