#endif
        const uint xb = (mt * 16u + row) * XS + ch8;
#ifdef AMD_REGISTER_INPUT
#ifdef M_AMD_EMBED_QUANT16
#define EMB_KEEP(N) for (int i_ = 0; i_ < 8; ++i_) XREG_[w][N][i_] = amdQuantizeHalf(x_[i_]);
#else
#define EMB_KEEP(N) XREG_[w][N] = ACC(x_);
#endif
#define EMB_N(N) { \
        AC32 x_ = BIASA(p.o[63] + 16u * (N), 40, 16u * (N), UC); \
        A8 a0, a1; LDA8(a0, p.o[62], 0u, UC, 16u * (N)); LDA8(a1, p.o[62], 1u, UC, 16u * (N)); \
        K32F(x_, a0, g0, a1, g1) EMB_KEEP(N) }
#else
#define EMB_N(N) { \
        AC32 x_ = BIASA(p.o[63] + 16u * (N), 40, 16u * (N), UC); \
        A8 a0, a1; LDA8(a0, p.o[62], 0u, UC, 16u * (N)); LDA8(a1, p.o[62], 1u, UC, 16u * (N)); \
        K32F(x_, a0, g0, a1, g1) \
        for (int i = 0; i < 8; ++i) X0S[xb + 16u * (N) + uint(i)] = float16_t(x_[i]); }
