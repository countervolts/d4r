            gatherFeatures(li, ivec2(X0, Y0), e1, e2, li < 32u, fe);
            const uint px = li & 7u, py = li >> 3;
            const uint at = (((py >> 2) * 2u + (px >> 2)) * 16u + (py & 3u) * 4u + (px & 3u)) * FS;
