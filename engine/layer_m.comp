        if (li < 64u && at.x >= 0 && at.y >= 0 && at.x < dp.size.x && at.y < dp.size.y)
        {
            const uint ht = (((py >> 2) * 2u + (px >> 2)) * 16u + (py & 3u) * 4u + (px & 3u));
#ifdef L_DUMP
            for (uint c = 0u; c < UC; ++c) ldump.a[(uint(at.y) * uint(p.W) + uint(at.x)) * UC + c] = HO[headIndex(ht, c)];
#endif
#define V(c) float(HO[headIndex(ht, uint(c))])
            imageStore(gateOut, at, HEAD_UNORM(vec4(sigmoidL(V(LH_GATE0)), sigmoidL(V(LH_GATE1)), sigmoidL(V(LH_GATE2)), 0.0)));
            const vec3 m = vec3(V(LH_MIX0), V(LH_MIX1), V(LH_MIX2)), ex = exp2((m - max(max(m.x, m.y), m.z)) * 1.442695);
            imageStore(mixOut, at, HEAD_UNORM(vec4(ex * (1.0 / (ex.z + (ex.x + ex.y))), 0.0)));
            const float a = dp.sigma * sigmoidL(clamp(V(LH_COVA), -20.0, 20.0)), b = dp.sigma * sigmoidL(clamp(V(LH_COVB), -20.0, 20.0));
            imageStore(covOut, at, vec4(a * a, b * b, a * b * tanhL(V(LH_RHO) * dp.rho), 0.0));
            imageStore(featOut, at, HEAD_SNORM(vec4(tanhL(V(LH_FEAT0)), tanhL(V(LH_FEAT1)), tanhL(V(LH_FEAT2)), tanhL(V(LH_FEAT3)))));
#undef V
        }
    }
#endif
#else
    // ------------------------------------------------------------ the block output, FP8
    FORW {
    WINV
    const uint dst = uint(ty * p.W + tx) * UC + ch8;
#if KIND == 3 && defined(M_AMD_PACKED_SKIP)
    // Each 8-channel packet is contiguous across pixels. Quantize the producer
    // once, then reuse those same operand bytes for the merge and the skip.
    [[unroll]] for (uint n_ = 0u; n_ < NT; ++n_) {
        MK8_F8(SKIP_Q_[w][n_], res[n_])
        if (inside) {
            const uint at_ = ((2u * n_ + hf) * uint(p.W) * uint(p.Hh) + uint(ty * p.W + tx)) * 2u;
            skipOut8.a[at_] = fe4m3vec4(SKIP_Q_[w][n_][0], SKIP_Q_[w][n_][1], SKIP_Q_[w][n_][2], SKIP_Q_[w][n_][3]);
            skipOut8.a[at_ + 1u] = fe4m3vec4(SKIP_Q_[w][n_][4], SKIP_Q_[w][n_][5], SKIP_Q_[w][n_][6], SKIP_Q_[w][n_][7]);
        }
    }
#else
    if (inside)
        for (uint nt = 0u; nt < NT; ++nt)
        {
#ifdef M_RES32
#define OUT8(I) out0.a[dst + 16u * nt + uint(I)] = floate4m3_t(clamp(res[nt][I], -448.0, 448.0));
#else
#define OUT8(I) out0.a[dst + 16u * nt + uint(I)] = floate4m3_t(CL8(res[nt][I]));
#endif
            OUT8(0) OUT8(1) OUT8(2) OUT8(3) OUT8(4) OUT8(5) OUT8(6) OUT8(7)
#undef OUT8
        }
#endif
    }
#endif
    // ------------------------------------------------------------ patch merge: 2x2 tokens (4C) -> XC, half resolution
#if MERGE
#if !(KIND == 3 && defined(AMD_REGISTER_INPUT) && defined(M_AMD_REGISTER_V))
    SYNC   // every wave is done with the V tiles in NB
#endif
    FORW {
        WINV
        // the 16 merged rows are gathered from the four waves: the row is the merged token of the lane's pixel
        const uint mrow = (byr >> 1) * 4u + (bxr >> 1), qq = (byr & 1u) * 2u + (bxr & 1u);
#ifdef M_AMD_PACKED_SKIP
#define MG_W(N) coopMatStore(SKIP_Q_[w][N], NB, UB8(16u * S4 + mrow * S4 + qq * UC + 16u * (N) - row * S4), UB8(S4), RM);
#else
#define MG_W(N) { A8 y; MK8_F8(y, res[N]); coopMatStore(y, NB, UB8(16u * S4 + mrow * S4 + qq * UC + 16u * (N) - row * S4), UB8(S4), RM); }
#endif
        EACH_T(MG_W)
    }
    SYNC
    FORW {
        WINV
        const uint MT = UXC / 16u, NI = (MT + 3u) / 4u;
        const int ym = (Y0 >> 1) + int(row >> 2), xm = (X0 >> 1) + int(row & 3u);
        const bool mok = ym >= 0 && ym < p.Hh / 2 && xm >= 0 && xm < p.W / 2;
#if PLANES
        const uint mt2 = uint(ym * (p.W / 2) + xm), mplane = uint(p.Hh / 2) * uint(p.W / 2) * 32u;
#define MADDR(C) ((C) >> 5) * mplane + mt2 * 32u + ((C) & 31u)
#else
        const uint md = uint(ym * (p.W / 2) + xm) * UXC;
#define MADDR(C) md + (C)
#endif
        for (uint i = 0u; i < NI; ++i)
        {
            const uint u = mt + 4u * i;
            if (u < MT)
            {
                AC32 y = BIASA(p.o[69] + 16u * u, 38, 16u * u, UXC);
                for (uint kt = 0u; kt < 4u * UC / 16u; kt += 2u)
                {
                    B8 b0, b1; coopMatLoad(b0, NB, UB8(16u * S4 + kt * 16u), UB8(S4), CM);
                    coopMatLoad(b1, NB, UB8(16u * S4 + (kt + 1u) * 16u), UB8(S4), CM);
                    A8 a0, a1; LDA8(a0, p.o[68], kt, UXC, 16u * u);
                    LDA8(a1, p.o[68], kt + 1u, UXC, 16u * u);
                    K32F(y, a0, b0, a1, b1)
                }
                if (mok)
                {
// NVIDIA's encoders clamp the merged result to +-2 pi (as f16) before its e4m3 encoding (kernels/m merge_clamp)
#define MGO(I) out1.a[MADDR(16u * u + ch8 + uint(I))] = floate4m3_t(clamp(float16_t(y[I]), -MCL, MCL));
                    MGO(0) MGO(1) MGO(2) MGO(3) MGO(4) MGO(5) MGO(6) MGO(7)
#undef MGO
#undef MADDR
                }
            }
        }
    }
#endif
}
