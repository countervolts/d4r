// of 10 x 10 pixels x 16 FP8 features) at byte 800
float16_t noiseAt(uint gx, uint gy, uint c)
{
    const uint b = 80u * gy + 8u * gx + 2u * c;
    return hb((sh[b >> 2] >> (8u * (b & 2u))) & 0xffffu);
}
