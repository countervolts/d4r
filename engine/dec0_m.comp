        const f16vec4 g = gate16(f16vec4(v1.z, v1.w, v2.x, v2.y));
#ifdef D4R_HLSL
        // AMD's D3D12 compiler fuses binary16 arithmetic even when precise: the four operations in f32 (exact for
        // binary16 operands), each rounded to binary16
        const vec4 g32 = vec4(g);
        const vec4 blend = d4rRne16(d4rRne16(d4rRne16(1.0 - g32) * vec4(hist)) +
                                    d4rRne16(g32 * vec4(tan16(f16vec4(v0.z, v0.w, v1.x, v1.y)))));
#else
        precise f16vec4 blend = (f16vec4(1.0) - g) * hist + g * tan16(f16vec4(v0.z, v0.w, v1.x, v1.y));
#endif
        imageStore(featOut, at, snorm8Value(vec4(blend)));
    }
}
