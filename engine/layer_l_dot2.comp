    const float s = scaleOf(m, inv2);
    [[unroll]] for (uint d = 0u; d < 8u; ++d) q[d] = q8h(v[2u * d], v[2u * d + 1u], inv2);
    return s;
}
// the same for pairs already grouped as (v0, v2), (v1, v3) (made from f32 values, where the grouping is free)
float quant16g(uint v[16], out uint q[8])
{
    uint m = 0u, inv2;
    [[unroll]] for (uint d = 0u; d < 16u; ++d) m = absMax16(m, v[d]);
    const float s = scaleOf(m, inv2);
    [[unroll]] for (uint d = 0u; d < 8u; ++d) q[d] = q8g(v[2u * d], v[2u * d + 1u], inv2);
    return s;
}
float quant32g(uint v[32], out uint q[16])
{
    uint m = 0u, inv2;
    [[unroll]] for (uint d = 0u; d < 32u; ++d) m = absMax16(m, v[d]);
    const float s = scaleOf(m, inv2);
    [[unroll]] for (uint d = 0u; d < 16u; ++d) q[d] = q8g(v[2u * d], v[2u * d + 1u], inv2);
    return s;
}
// layer_m_dot2.comp's GELU on a binary16 pair
uint gelu2(uint v)
{
    const f16vec2 x = unpackFloat2x16(v), y = clamp(x, f16vec2(-2.0), f16vec2(2.0));
    return packFloat2x16(x * fma(y, fma(-abs(y), f16vec2(0.08108133), f16vec2(0.41216981)), f16vec2(0.5)));
