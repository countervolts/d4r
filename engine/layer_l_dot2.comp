// ia[n] = the int8 products of the lane's 8 words with the 32 columns of the [32/4][32] int8 matrix at word w
void gemm8(out int ia[32], uint a[8], uint w)
{
    [[unroll]] for (uint n = 0u; n < 32u; ++n) ia[n] = 0;
    [[unroll]] for (uint k = 0u; k < 8u; ++k)
        [[unroll]] for (uint n = 0u; n < 32u; ++n) ia[n] += dotPacked4x8EXT(int(a[k]), int(wb.w[w + k * 32u + n]));
}
// the same with 16 words: the [64/4][32] matrix at word w (16 words = 512 dot4 per lane)
void gemm16(out int ia[32], uint a[16], uint w)
{
    [[unroll]] for (uint n = 0u; n < 32u; ++n) ia[n] = 0;
    [[unroll]] for (uint k = 0u; k < 16u; ++k)
        [[unroll]] for (uint n = 0u; n < 32u; ++n) ia[n] += dotPacked4x8EXT(int(a[k]), int(wb.w[w + k * 32u + n]));
