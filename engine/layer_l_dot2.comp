    const f16vec2 t = clamp(unpackFloat2x16(s) * cs, -lim, lim);
    const f16vec2 q = fma(t, fma(t, -t, f16vec2(0.92730712890625)), f16vec2(1.375));
    return (packFloat2x16(q) << 5) + 0x7FF88000u;
