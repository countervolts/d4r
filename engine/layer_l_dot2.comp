            {
                oh[16u * h + 2u * d] = pk(o[4u * d], o[4u * d + 2u]);
                oh[16u * h + 2u * d + 1u] = pk(o[4u * d + 1u], o[4u * d + 3u]);
            }
        }
        // the output projection, both heads' 64 channels against the [64][32] wo
        uint oq[16];
        const float os = quant32g(oh, oq);
        int ia[32];
        gemm16(ia, oq, wo);
        [[unroll]] for (uint n = 0u; n < 32u; ++n) acc[n] = fma(float(ia[n]), os * uintBitsToFloat(wb.w[wo + 16u * 32u + n]), acc[n]);
    }
    // ------------------------------------------------------------ norm 2: the residual rounded to binary16, h = x rsqrt(sum
    // x^2) g2 as int8, and the stream continues as x + b2
    {
        float s2 = 0.0;
        uint h[16];
        f16vec2 x[16];
        [[unroll]] for (uint d = 0u; d < 16u; ++d)
        {
            x[d] = f16vec2(acc[2u * d], acc[2u * d + 1u]);
            const vec2 f = vec2(x[d]);
            s2 += f.x * f.x + f.y * f.y;
            const f16vec2 y = x[d] + unpackFloat2x16(f16w(p.o[3] + 2u * d));
            acc[2u * d] = float(y.x); acc[2u * d + 1u] = float(y.y);
        }
        const float16_t rn = rsq16(s2);
        [[unroll]] for (uint d = 0u; d < 16u; ++d) h[d] = packFloat2x16(x[d] * unpackFloat2x16(f16w(p.o[2] + 2u * d)) * rn);
        hs = quant16(h, h8);
    }
    // ------------------------------------------------------------ the MLP, two chunks of 32 hidden channels at a time:
    // h = gelu(b1 + h1 w1) in binary16, the pair's 64 values as int8 with one scale, the residual += h w2 (the pair's w2
    // blocks share their column scales, widenM: one int32 sum and one epilogue for both)
    [[unroll]] for (uint c = 0u; c < 4u; c += 2u)
    {
        uint hh[32];
        [[unroll]] for (uint k = 0u; k < 2u; ++k)
        {
            int ia[32];
            const uint w1 = p.o[20u + 3u * (c + k)] / 2u;
            gemm8(ia, h8, w1);
            float v[32];
            [[unroll]] for (uint n = 0u; n < 32u; n += 2u)
            {
                const uint b = f16w(p.o[21u + 3u * (c + k)] + n);
                v[n] = fma(float(ia[n]), hs * uintBitsToFloat(wb.w[w1 + 256u + n]), lo(b));
                v[n + 1u] = fma(float(ia[n + 1u]), hs * uintBitsToFloat(wb.w[w1 + 256u + n + 1u]), hi(b));
            }
            [[unroll]] for (uint d = 0u; d < 8u; ++d)
            {
                hh[16u * k + 2u * d] = gelu2(pk(v[4u * d], v[4u * d + 2u]));
                hh[16u * k + 2u * d + 1u] = gelu2(pk(v[4u * d + 1u], v[4u * d + 3u]));
            }
        }
        uint g8[16];
        const float cs = quant32g(hh, g8);
        int ia[32];
        [[unroll]] for (uint n = 0u; n < 32u; ++n) ia[n] = 0;
        [[unroll]] for (uint k = 0u; k < 2u; ++k)
        {
            const uint w2 = p.o[22u + 3u * (c + k)] / 2u;
            [[unroll]] for (uint d = 0u; d < 8u; ++d)
                [[unroll]] for (uint n = 0u; n < 32u; ++n) ia[n] += dotPacked4x8EXT(int(g8[8u * k + d]), int(wb.w[w2 + d * 32u + n]));
        }
        const uint ws = p.o[22u + 3u * c] / 2u + 8u * 32u;
        [[unroll]] for (uint n = 0u; n < 32u; ++n) acc[n] = fma(float(ia[n]), cs * uintBitsToFloat(wb.w[ws + n]), acc[n]);
    }
#if KIND == 3
    // ------------------------------------------------------------ the block output, FP8 (the expansion's skip input)
    {
        const int ty = Y0 + int(bp.y), tx = X0 + int(bp.x);
        if (ty >= 0 && ty < p.Hh && tx >= 0 && tx < p.W)
        {
            const uint dst = uint(ty * p.W + tx) * 8u;
            [[unroll]] for (uint d = 0u; d < 8u; ++d)
                out0.a[dst + d] = e4m3CodesHalf2(q8p(acc[4u * d], acc[4u * d + 1u])) | (e4m3CodesHalf2(q8p(acc[4u * d + 2u], acc[4u * d + 3u])) << 16);
        }
    }
#else
    // ------------------------------------------------------------ the head: the block output as binary16, per pixel the
    // reconstruction's inputs (layer_m.comp KIND 4): natural channels 0, 1, 12 (gates), 4, 5, 8, 9 (feature, no history),
    // 13, 16, 17 (mix), 20, 21, 24 (covariance a, b, rho)
    {
        const ivec2 at = ivec2(X0 + int(bp.x), Y0 + int(bp.y));
        if (at.x >= 0 && at.y >= 0 && at.x < dp.size.x && at.y < dp.size.y)
        {
#define V(c) float(float16_t(acc[c]))
            imageStore(gateOut, at, unorm8Value(vec4(sigmoidL(V(0)), sigmoidL(V(1)), sigmoidL(V(12)), 0.0)));
            const vec3 m = vec3(V(13), V(16), V(17)), ex = exp2((m - max(max(m.x, m.y), m.z)) * 1.442695);
            imageStore(mixOut, at, unorm8Value(vec4(ex * (1.0 / (ex.z + (ex.x + ex.y))), 0.0)));
            const float a = dp.sigma * sigmoidL(clamp(V(20), -20.0, 20.0)), b = dp.sigma * sigmoidL(clamp(V(21), -20.0, 20.0));
            imageStore(covOut, at, vec4(a * a, b * b, a * b * tanhL(V(24) * dp.rho), 0.0));
            imageStore(featOut, at, snorm8Value(vec4(tanhL(V(4)), tanhL(V(5)), tanhL(V(8)), tanhL(V(9)))));
#undef V
        }
    }
#endif
}
