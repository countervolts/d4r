}
float16_t rsq16(float sumSquares) { return float16_t(inversesqrt(float(float16_t(sumSquares) + float16_t(0.0001220703125)))); }
// The int8 quantisation in packed binary16: NP binary16 pairs (natural channel order) as NP / 2 int8 words with one
// scale, the largest magnitude / 127. v inv + 1536 rounded once to binary16 (v_pk_fma_f16) has spacing 1 in [1024, 2048),
// so its low byte is the rounded int8 value (q8x4); the pairs regroup as (v0, v2), (v1, v3) so one mask and shift
// pack the bytes in channel order. inv is binary16 (at most 65504): |v inv| stays below 127.5.
uint q8g(uint u02, uint u13, uint inv2)
{
    const f16vec2 i = unpackFloat2x16(inv2), c = f16vec2(1536.0);
    const uint a = packFloat2x16(fma(unpackFloat2x16(u02), i, c)), b = packFloat2x16(fma(unpackFloat2x16(u13), i, c));
    return (a & 0x00FF00FFu) | ((b & 0x00FF00FFu) << 8);
}
uint q8h(uint u0, uint u1, uint inv2) { return q8g((u0 & 0xFFFFu) | (u1 << 16), (u0 >> 16) | (u1 & 0xFFFF0000u), inv2); }
uint absMax16(uint m, uint v) { const u16vec2 a = unpack16(m), b = unpack16(v & 0x7FFF7FFFu); return pack32(max(a, b)); }
// the step for the largest magnitude (two binary16 halves of m): returns the scale, inv2 the binary16 reciprocal pair
float scaleOf(uint m, out uint inv2)
{
    const float mx = float(uint16BitsToFloat16(uint16_t(max(m & 0xFFFFu, m >> 16))));
    const float16_t inv = float16_t(mx > 0.0 ? min(127.0 / mx, 65504.0) : 0.0);
    inv2 = packFloat2x16(f16vec2(inv));
    return mx * (1.0 / 127.0);
}
float quant16(uint v[16], out uint q[8])
{
    uint m = 0u, inv2;
