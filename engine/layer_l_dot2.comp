// the patch expand: q8 of the expansion's 4 x 32 columns of the two blocks' 32 low-resolution tokens as binary16 pairs
// (rows of ERS: sub-position q at 16 q)
const uint ERS = 64u + 4u;
shared uint EX[32 * ERS];
