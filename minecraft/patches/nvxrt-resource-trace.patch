+static VKAPI_ATTR void VKAPI_CALL T_CmdFillBuffer(VkCommandBuffer cmd, VkBuffer b, VkDeviceSize o, VkDeviceSize n, uint32_t d)
+{ TRC_PRE(cmd); if (g_trace) logf("EV fill buf %p off %" PRIu64 " size %" PRIu64 " data %u", (void *)b, (uint64_t)o, (uint64_t)n, d);
+  dev->d.CmdFillBuffer(cmd, b, o, n, d); }
+static VKAPI_ATTR void VKAPI_CALL T_CmdUpdateBuffer(VkCommandBuffer cmd, VkBuffer b, VkDeviceSize o, VkDeviceSize n, const void *d)
+{ TRC_PRE(cmd); if (g_trace) logf("EV update buf %p off %" PRIu64 " size %" PRIu64 " hex %s", (void *)b, (uint64_t)o, (uint64_t)n, hex((const uint8_t *)d, (size_t)n).c_str());
+  dev->d.CmdUpdateBuffer(cmd, b, o, n, d); }
