+pub(crate) unsafe fn get_descriptor_v2(
+    output: &mut HIP_ARRAY_DESCRIPTOR,
+    array: hipArray_t,
+) -> hipError_t {
+    hipArrayGetDescriptor(output, array)?;
+    if let Some(format) = original_format(array)? {
+        output.Format = hipArray_Format(format);
+    }
+    Ok(())
+}
+
+pub(crate) unsafe fn _3d_get_descriptor_v2(
+    output: &mut HIP_ARRAY3D_DESCRIPTOR,
+    array: hipArray_t,
+) -> hipError_t {
+    hipArray3DGetDescriptor(output, array)
+}
