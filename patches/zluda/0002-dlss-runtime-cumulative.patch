index 0000000..d89069d
--- /dev/null
+++ b/ptx/examples/d4r_emit.rs
@@ -0,0 +1,37 @@
+use std::{env, fs, path::PathBuf};
+use ptx_parser::parse_module_checked;
+
+fn main() {
+    let input = env::args().nth(1).expect("PTX path");
+    let outdir = PathBuf::from(env::args().nth(2).unwrap_or_else(|| "/tmp/d4r-autoexposure-emitted".into()));
+    fs::create_dir_all(&outdir).expect("create output directory");
+    let bytes = fs::read(&input).expect("read PTX");
+    let text = std::str::from_utf8(&bytes).expect("PTX UTF-8").trim_end_matches('\0');
+    let ast = parse_module_checked(text).unwrap_or_else(|e| panic!("PTX parse failed: {e:?}"));
+    let module = ptx::to_llvm_module(ast, ptx::Attributes { clock_rate: 2_500_000 }, |_| {})
+        .unwrap_or_else(|e| panic!("PTX translation failed: {e:?}"));
+    fs::write(outdir.join("ptx.ll"), module.llvm_ir.print_module_to_string().to_bytes()).expect("write translated IR");
+    let linked_helpers = module.linked_bitcode();
+    let hook = |data: &Vec<u8>, stage: String| {
+        let filename = match stage.as_str() {
+            "linked.ll" => "linked.ll",
+            "opt.ll" => "opt.ll",
+            "asm" => "asm.s",
+            "o" => "object.o",
+            other => panic!("unexpected stage: {other}"),
+        };
+        fs::write(outdir.join(filename), data).expect("write compiler stage");
+    };
+    let elf = llvm_zluda::compile(
+        &module.context,
+        "gfx1101",
+        module.llvm_ir,
+        linked_helpers,
+        module.attributes_ir,
+        module.metadata,
+        module.metadata32,
+        Some(&hook),
+    ).unwrap_or_else(|e| panic!("AMDGPU code generation failed: {e}"));
+    fs::write(outdir.join("module.hsaco"), &elf).expect("write linked code object");
+    println!("emitted AMDGPU code object: {}", outdir.join("module.hsaco").display());
+}
