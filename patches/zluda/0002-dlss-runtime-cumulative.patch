 use hip_runtime_sys::*;
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+fn original_formats() -> &'static Mutex<HashMap<usize, u32>> {
+    static FORMATS: OnceLock<Mutex<HashMap<usize, u32>>> = OnceLock::new();
+    FORMATS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+pub(crate) fn original_format(array: hipArray_t) -> Result<Option<u32>, hipErrorCode_t> {
+    original_formats()
+        .lock()
+        .map(|formats| formats.get(&(array as usize)).copied())
+        .map_err(|_| hipErrorCode_t::Unknown)
