+// The git SHA alone does not change for uncommitted translator or helper
+// changes, so stale compiled modules would be served after a rebuild. Mix in
+// the size and modification time of the loaded ZLUDA library itself.
+fn zluda_build_version() -> &'static str {
+    static VERSION: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    VERSION.get_or_init(|| {
+        let sha = env!("VERGEN_GIT_SHA");
+        match loaded_library_fingerprint() {
+            Some(fingerprint) => format!("{sha}+{fingerprint}"),
+            None => sha.to_string(),
+        }
+    })
+}
+
+#[cfg(not(windows))]
+fn loaded_library_fingerprint() -> Option<String> {
+    use std::os::unix::fs::MetadataExt;
+    let mut info: libc::Dl_info = unsafe { mem::zeroed() };
+    let address = zluda_build_version as *const libc::c_void;
+    if unsafe { libc::dladdr(address, &mut info) } == 0 || info.dli_fname.is_null() {
+        return None;
+    }
+    let path = unsafe { CStr::from_ptr(info.dli_fname) }.to_str().ok()?;
+    let metadata = fs::metadata(path).ok()?;
+    Some(format!(
+        "{:x}.{:x}.{:x}",
+        metadata.len(),
+        metadata.mtime(),
+        metadata.mtime_nsec()
+    ))
+}
+
+#[cfg(windows)]
+fn loaded_library_fingerprint() -> Option<String> {
+    None
+}
