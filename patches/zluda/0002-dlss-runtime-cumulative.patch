+        let text = std::str::from_utf8(&bytes).expect("PTX UTF-8").trim_end_matches('\0');
+        let unchecked = parse_module_unchecked(text);
+        println!("{}: version={:?} sm={} directives={} invalid_directives={}",
+            path, unchecked.ptx_version, unchecked.sm_version, unchecked.directives.len(), unchecked.invalid_directives);
+        match parse_module_checked(text) {
+            Ok(module) => println!("  checked: OK directives={}", module.directives.len()),
+            Err(errors) => {
+                println!("  checked: {} parser errors", errors.len());
+                for error in errors { println!("    {error:?}"); }
+            }
+        }
+    }
+}
diff --git a/zluda/src/impl/surf.rs b/zluda/src/impl/surf.rs
new file mode 100644
index 0000000..5ef0f53
--- /dev/null
+++ b/zluda/src/impl/surf.rs
@@ -0,0 +1,113 @@
+use crate::r#impl::array;
+use hip_runtime_sys::*;
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+// Device layout of a ZLUDA surface object. It starts with a copy of HIP's
+// image object so the handle is also a valid texture object for integer
+// (texel) fetches: NVIDIA shares descriptors between the two, and NGX reads
+// in-place-updated arrays through surface handles with tex. The CUDA format
+// follows the (zeroed) sampler slot.
+const IMAGE_OBJECT_BYTES: usize = 48; // HIP_IMAGE_OBJECT_SIZE_DWORD * 4
+const SAMPLER_OBJECT_BYTES: usize = 32; // HIP_SAMPLER_OBJECT_SIZE_DWORD * 4
+const FORMAT_OFFSET: usize = IMAGE_OBJECT_BYTES + SAMPLER_OBJECT_BYTES;
+const HANDLE_BYTES: usize = FORMAT_OFFSET + 16;
+
+struct SurfaceInfo {
+    native: usize,
+    descriptor: Vec<u8>,
+}
+
+fn surface_resources() -> &'static Mutex<HashMap<usize, SurfaceInfo>> {
+    static RESOURCES: OnceLock<Mutex<HashMap<usize, SurfaceInfo>>> = OnceLock::new();
+    RESOURCES.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+pub(crate) unsafe fn object_create(
+    surface: &mut hipSurfaceObject_t,
+    resource: *const HIP_RESOURCE_DESC,
+) -> hipError_t {
+    let descriptor = match resource.as_ref() {
+        Some(value) => value,
+        None => return Err(hipErrorCode_t::r#InvalidValue),
+    };
+    let cuda_format = if descriptor.resType == HIPresourcetype::HIP_RESOURCE_TYPE_ARRAY {
+        array::original_format(descriptor.res.array.hArray)?.unwrap_or(0)
+    } else {
+        0
+    };
+    let mut native = std::ptr::null_mut();
+    hipCreateSurfaceObject(&mut native, resource.cast::<hipResourceDesc>())?;
+    let mut device_handle = std::ptr::null_mut();
+    if let Err(error) = hipMalloc(&mut device_handle, HANDLE_BYTES) {
+        let _ = hipDestroySurfaceObject(native);
+        return Err(error);
+    }
+    let mut tail = [0u32; (HANDLE_BYTES - IMAGE_OBJECT_BYTES) / 4];
+    tail[(FORMAT_OFFSET - IMAGE_OBJECT_BYTES) / 4] = cuda_format;
+    let written = hipMemcpyDtoD(
+        hipDeviceptr_t(device_handle),
+        hipDeviceptr_t(native.cast()),
+        IMAGE_OBJECT_BYTES,
+    )
+    .and_then(|()| {
+        hipMemcpyHtoD(
+            hipDeviceptr_t(device_handle.cast::<u8>().add(IMAGE_OBJECT_BYTES).cast()),
+            tail.as_mut_ptr().cast(),
+            HANDLE_BYTES - IMAGE_OBJECT_BYTES,
+        )
+    });
+    if let Err(error) = written {
+        let _ = hipFree(device_handle);
+        let _ = hipDestroySurfaceObject(native);
+        return Err(error);
+    }
+    *surface = device_handle.cast();
+    let key = device_handle as usize;
+    let bytes = std::slice::from_raw_parts(
+        (descriptor as *const HIP_RESOURCE_DESC).cast::<u8>(),
+        std::mem::size_of::<HIP_RESOURCE_DESC>(),
+    )
+    .to_vec();
+    if let Ok(mut resources) = surface_resources().lock() {
+        resources.insert(key, SurfaceInfo { native: native as usize, descriptor: bytes });
+        Ok(())
+    } else {
+        let _ = hipFree(device_handle);
+        let _ = hipDestroySurfaceObject(native);
+        Err(hipErrorCode_t::r#Unknown)
+    }
+}
+
+pub(crate) unsafe fn object_destroy(surface: hipSurfaceObject_t) -> hipError_t {
+    let info = surface_resources()
+        .lock()
+        .map_err(|_| hipErrorCode_t::Unknown)?
+        .remove(&(surface as usize))
+        .ok_or(hipErrorCode_t::InvalidValue)?;
+    let native_result = hipDestroySurfaceObject(info.native as hipSurfaceObject_t);
+    let free_result = hipFree(surface.cast());
+    native_result?;
+    free_result
+}
+
+pub(crate) unsafe fn object_get_resource_desc(
+    output: &mut HIP_RESOURCE_DESC,
+    surface: hipSurfaceObject_t,
+) -> hipError_t {
+    let resources = match surface_resources().lock() {
+        Ok(value) => value,
+        Err(_) => return Err(hipErrorCode_t::r#Unknown),
+    };
+    let bytes = match resources.get(&(surface as usize)) {
+        Some(value) if value.descriptor.len() == std::mem::size_of::<HIP_RESOURCE_DESC>() =>
+            &value.descriptor,
+        _ => return Err(hipErrorCode_t::r#InvalidValue),
+    };
+    std::ptr::copy_nonoverlapping(
+        bytes.as_ptr(),
+        (output as *mut HIP_RESOURCE_DESC).cast::<u8>(),
+        bytes.len(),
+    );
+    Ok(())
+}
