+// d4r: device-library image wrappers (__llvm_amdgcn_image_*, called by ZLUDA's texture/surface
+// helpers) were left as calls: their FP attributes did not match the strictfp kernels, so the
+// inliner refused them. Each call then began with a full s_waitcnt and a readfirstlane
+// waterfall over the (actually uniform) resource descriptor. The wrappers contain no FP math,
+// so give them the caller-compatible "dynamic" denormal mode and strictfp, and force inlining.
+extern "C" unsigned LLVMZludaInlineImageHelpers(LLVMModuleRef ModuleRef)
+{
+    Module* M = unwrap(ModuleRef);
+    unsigned Changed = 0;
+    for (Function& F : *M)
+    {
+        const StringRef N = F.getName();
+        if (F.isDeclaration() || !N.starts_with("__llvm_amdgcn_image_"))
+            continue;
+        F.removeFnAttr(Attribute::NoInline);
+        F.removeFnAttr(Attribute::OptimizeNone);
+        F.addFnAttr(Attribute::AlwaysInline);
+        F.addFnAttr("denormal-fp-math", "dynamic,dynamic");
+        F.addFnAttr("denormal-fp-math-f32", "dynamic,dynamic");
+        F.addFnAttr(Attribute::StrictFP); // no FP math inside
+        for (User* U : F.users())
+            if (auto* CB = dyn_cast<CallBase>(U))
+                CB->removeFnAttr(Attribute::NoInline);
+        ++Changed;
+    }
+    return Changed;
+}
+
+// d4r: D4R_ZLUDA_FAST_MATH=1 lets LLVM contract/approximate FP arithmetic (contract, afn, arcp,
+// nsz). NaN/Inf semantics are kept (DLSS sanitises NaN inputs explicitly). Not part of the JIT
+// cache key: use a fresh cache when toggling it.
+extern "C" unsigned LLVMZludaRelaxFastMath(LLVMModuleRef ModuleRef)
+{
+    Module* M = unwrap(ModuleRef);
+    unsigned Changed = 0;
+    for (Function& F : *M)
+    {
+        if (F.isDeclaration())
+            continue;
+        for (BasicBlock& BB : F)
+            for (Instruction& I : BB)
+            {
+                if (!isa<FPMathOperator>(&I))
+                    continue;
+                // constrained (strictfp) intrinsics carry their own semantics
+                if (isa<ConstrainedFPIntrinsic>(&I))
+                    continue;
+                FastMathFlags FMF = I.getFastMathFlags();
+                FMF.setAllowContract(true);
+                FMF.setApproxFunc(true);
+                FMF.setAllowReciprocal(true);
+                FMF.setNoSignedZeros(true);
+                I.setFastMathFlags(FMF);
+                ++Changed;
+            }
+    }
+    return Changed;
+}
