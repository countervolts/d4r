+/// d4r: hand-written native replacement for a PTX kernel. With D4R_ZLUDA_NATIVE_DIR set, a kernel
+/// NAME is served from DIR/NAME.hsaco when that file exists (same name, launch shape and parameter
+/// block as the PTX kernel). An optional NAME_prep kernel in the same code object runs first on the
+/// same stream with `d4r_prep_blocks` (a u32 global in the code object) blocks of 128 threads.
+/// An optional u32 global `d4r_block_z` replaces the launch's block z dimension, and `d4r_grid_x`
+/// (persistent kernels, which derive the original grid from their parameters) the grid.
+fn native_override(name: &CStr) -> Option<(hipFunction_t, Option<(hipFunction_t, u32)>, u32, u32, u32)> {
+    let dir = std::env::var_os("D4R_ZLUDA_NATIVE_DIR")?;
+    let path = std::path::Path::new(&dir).join(format!("{}.hsaco", name.to_str().ok()?));
+    let image = fs::read(&path).ok()?;
+    // HIP may reference the image after loading; the override lives for the whole process.
+    let image: &'static [u8] = Box::leak(image.into_boxed_slice());
+    let mut native_module = unsafe { mem::zeroed() };
+    if unsafe { hipModuleLoadData(&mut native_module, image.as_ptr().cast()) }.is_err() {
+        eprintln!("[d4r-native] failed to load {}", path.display());
+        return None;
+    }
+    let mut func = unsafe { mem::zeroed() };
+    if unsafe { hipModuleGetFunction(&mut func, native_module, name.as_ptr()) }.is_err() {
+        eprintln!("[d4r-native] {} has no kernel {:?}", path.display(), name);
+        return None;
+    }
+    let prep_name = CString::new(format!("{}_prep", name.to_str().ok()?)).ok()?;
+    let mut prep_func = unsafe { mem::zeroed() };
+    let prep = if unsafe { hipModuleGetFunction(&mut prep_func, native_module, prep_name.as_ptr()) }.is_ok() {
+        let mut blocks_ptr = unsafe { mem::zeroed() };
+        let mut size = 0usize;
+        let mut blocks = 0u32;
+        let found = unsafe {
+            hipModuleGetGlobal(&mut blocks_ptr, &mut size, native_module, c"d4r_prep_blocks".as_ptr())
+        }
+        .is_ok()
+            && size == 4
+            && unsafe { hipMemcpyDtoH((&mut blocks as *mut u32).cast(), blocks_ptr, 4) }.is_ok();
+        if !found || blocks == 0 {
+            eprintln!("[d4r-native] {} has {:?} but no d4r_prep_blocks", path.display(), prep_name);
+            return None;
+        }
+        Some((prep_func, blocks))
+    } else {
+        None
+    };
+    let read_u32 = |symbol: &CStr| -> u32 {
+        let mut ptr = unsafe { mem::zeroed() };
+        let mut size = 0usize;
+        let mut value = 0u32;
+        if unsafe { hipModuleGetGlobal(&mut ptr, &mut size, native_module, symbol.as_ptr()) }.is_ok()
+            && size == 4
+            && unsafe { hipMemcpyDtoH((&mut value as *mut u32).cast(), ptr, 4) }.is_ok()
+        {
+            value
+        } else {
+            0
+        }
+    };
+    let block_z = read_u32(c"d4r_block_z");
+    let grid_x = read_u32(c"d4r_grid_x");
+    // byte offset of a u64 in the parameter block that fully determines the prep kernel's output
+    // (the weights pointer): the prep is skipped while it repeats (0 = prep before every launch)
+    let prep_key = read_u32(c"d4r_prep_key_offset");
+    eprintln!(
+        "[d4r-native] {:?} -> {} (prep: {:?}, block_z: {}, grid_x: {}, prep_key: {})",
+        name,
+        path.display(),
+        prep.map(|p| p.1),
+        block_z,
+        grid_x,
+        prep_key
+    );
+    Some((func, prep, block_z, grid_x, prep_key))
+}
