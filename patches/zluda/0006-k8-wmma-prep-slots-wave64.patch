+// d4r: an m16n8k8 f16 MMA is an m16n8k16 one whose second K half is zero (its A fragment is the k16
+// A's registers 0-1, its B the k16 B's register 0), and adding zero products is exact. Each k8 call
+// becomes a k16 call so the WMMA rewrite below lowers it too. Zero halves are loads of one zeroed
+// register, so the operands stay "loads of plain registers" and two k8 MMAs that share A still fuse
+// into one WMMA. Returns the number of calls converted.
+static unsigned widenMmaK8(Module *M)
+{
+    Function *K8 = M->getFunction("__zluda_ptx_impl_mma_sync_aligned_m16n8k8_row_col_f16_f16_f16_f16");
+    if (K8 == nullptr || K8->use_empty())
+        return 0;
+    LLVMContext &Context = M->getContext();
+    Type *I32 = Type::getInt32Ty(Context);
+    Type *V2 = FixedVectorType::get(I32, 2);
+    Type *V4 = FixedVectorType::get(I32, 4);
+    AttributeList Attributes = AttributeList::get(Context, AttributeList::FunctionIndex,
+                                                  AttrBuilder(Context, K8->getAttributes().getFnAttrs()));
+    FunctionCallee K16 = M->getOrInsertFunction(kMmaF16, Attributes, V2, V4, V2, V2);
+    SmallVector<CallInst *, 64> Calls;
+    for (User *U : K8->users())
+        if (auto *Call = dyn_cast<CallInst>(U); Call != nullptr && Call->getCalledFunction() == K8)
+            Calls.push_back(Call);
+    DenseMap<Function *, AllocaInst *> Zeros;
+    for (CallInst *Call : Calls)
+    {
+        Function *F = Call->getFunction();
+        AllocaInst *&Zero = Zeros[F];
+        if (Zero == nullptr)
+        {
+            // an alloca like ZLUDA's register allocas (same address space), stored once at entry
+            AllocaInst *Like = nullptr;
+            for (Instruction &I : F->getEntryBlock())
+                if ((Like = dyn_cast<AllocaInst>(&I)) != nullptr)
+                    break;
+            IRBuilder<> Entry(&*F->getEntryBlock().getFirstInsertionPt());
+            Zero = Entry.CreateAlloca(I32, Like != nullptr ? Like->getAddressSpace() : 5, nullptr, "d4r.k8.zero");
+            Entry.CreateStore(Entry.getInt32(0), Zero);
+        }
+        IRBuilder<> Builder(Call);
+        SmallVector<AllocaInst *, 2> ARegisters, BRegisters;
+        auto build = [&](ArrayRef<Value *> Elements) {
+            Value *Vector = UndefValue::get(FixedVectorType::get(I32, Elements.size()));
+            for (unsigned Index = 0; Index < Elements.size(); ++Index)
+                Vector = Builder.CreateInsertElement(Vector, Elements[Index], Builder.getInt8(Index));
+            return Vector;
+        };
+        auto zero = [&]() { return Builder.CreateLoad(I32, Zero); };
+        // the registers may be reloaded at the call only if no store reaches them after their original loads
+        auto unchangedSinceLoads = [&](Value *Vector) {
+            for (Value *V = Vector; auto *Insert = dyn_cast<InsertElementInst>(V); V = Insert->getOperand(0))
+            {
+                auto *Load = cast<LoadInst>(Insert->getOperand(1));
+                if (Load->getParent() != Call->getParent() ||
+                    storesBetween(Load, Call, {cast<AllocaInst>(Load->getPointerOperand())}))
+                    return false;
+            }
+            return true;
+        };
+        // B is one register: a <1 x i32> vector or a plain i32
+        Value *BArg = Call->getArgOperand(1);
+        auto bRegister = [&]() {
+            if (BArg->getType()->isVectorTy())
+                return matchLoadedVector(BArg, 1, BRegisters) && unchangedSinceLoads(BArg);
+            auto *Load = dyn_cast<LoadInst>(BArg);
+            auto *Register = Load != nullptr ? dyn_cast<AllocaInst>(Load->getPointerOperand()) : nullptr;
+            if (Register == nullptr || !Register->getAllocatedType()->isIntegerTy(32) || !isPlainRegister(Register) ||
+                Load->getParent() != Call->getParent() || storesBetween(Load, Call, {Register}))
+                return false;
+            BRegisters.assign(1, Register);
+            return true;
+        };
+        auto element = [&](Value *V, unsigned Index) -> Value * {
+            return V->getType()->isVectorTy() ? Builder.CreateExtractElement(V, Builder.getInt8(Index)) : V;
+        };
+        Value *A, *B;
+        if (matchLoadedVector(Call->getArgOperand(0), 2, ARegisters) && bRegister() &&
+            unchangedSinceLoads(Call->getArgOperand(0)))
+        {
+            // reload the same registers right at the call (nothing lies between these loads and it)
+            Value *A0 = Builder.CreateLoad(I32, ARegisters[0]), *A1 = Builder.CreateLoad(I32, ARegisters[1]);
+            Value *B0 = Builder.CreateLoad(I32, BRegisters[0]);
+            A = build({A0, A1, zero(), zero()});
+            B = build({B0, zero()});
+        }
+        else
+        {
+            Value *A0 = Builder.CreateExtractElement(Call->getArgOperand(0), Builder.getInt8(0));
+            Value *A1 = Builder.CreateExtractElement(Call->getArgOperand(0), Builder.getInt8(1));
+            Value *B0 = element(BArg, 0);
+            A = build({A0, A1, Builder.getInt32(0), Builder.getInt32(0)});
+            B = build({B0, Builder.getInt32(0)});
+        }
+        CallInst *Wide = Builder.CreateCall(K16, {A, B, Call->getArgOperand(2)});
+        Call->replaceAllUsesWith(Wide);
+        Call->eraseFromParent();
+    }
+    return static_cast<unsigned>(Calls.size());
+}
