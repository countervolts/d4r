+fn read_native_image(path: &std::path::Path) -> Option<&'static [u8]> {
+    let image = fs::read(path).ok()?;
+    // HIP can crash on a short or truncated code object: an ELF's section headers (e_shoff, e_shentsize, e_shnum) must fit
+    let le = |at: usize, size: usize| image[at..at + size].iter().rev().fold(0u64, |v, &b| (v << 8) | u64::from(b));
+    if image.len() < 64
+        || (image.starts_with(b"\x7fELF") && le(40, 8).saturating_add(le(58, 2) * le(60, 2)) > image.len() as u64)
+    {
+        eprintln!("[d4r-native] {} is truncated ({} bytes)", path.display(), image.len());
+        return None;
+    }
+    // HIP may reference the image after loading; the override lives for the whole process.
+    Some(Box::leak(image.into_boxed_slice()))
+}
+
+/// d4r: a module whose every visible kernel has a native replacement (and that has no globals to look up)
+/// is not compiled when it is loaded: its kernels are served by native_override, and the PTX is compiled
+/// only if another function is requested. On RDNA2 the DLSS transformer layers each took minutes to
+/// compile (emulated MMA) for code that never ran. The returned module, the first kernel's native code
+/// object, stands in for the compiled one (unload, lookups).
+fn native_placeholder(ast: &ptx_parser::Module) -> Option<hipModule_t> {
+    let dir = std::env::var_os("D4R_ZLUDA_NATIVE_DIR")?;
+    if ast.invalid_directives != 0 || ast.address_size != 64 {
+        return None;
+    }
+    let mut first = None;
+    for directive in &ast.directives {
+        match directive {
+            ptx_parser::Directive::Variable(_, variable) => {
+                if variable.info.state_space != ptx_parser::StateSpace::Shared {
+                    return None;
+                }
+            }
+            ptx_parser::Directive::Method(linking, function) => {
+                let name = &function.func_directive.name;
+                if !name.is_kernel() || !linking.contains(ptx_parser::LinkingDirective::VISIBLE) {
+                    continue;
+                }
+                let path = std::path::Path::new(&dir).join(format!("{}.hsaco", name.text()));
+                if !path.is_file() {
+                    return None;
+                }
+                first.get_or_insert(path);
+            }
+        }
+    }
+    let image = read_native_image(&first?)?;
+    let mut module = unsafe { mem::zeroed() };
+    unsafe { hipModuleLoadData(&mut module, image.as_ptr().cast()) }.ok()?;
+    Some(module)
+}
