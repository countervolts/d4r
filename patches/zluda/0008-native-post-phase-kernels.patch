--- a/zluda/src/impl/function.rs
+++ b/zluda/src/impl/function.rs
@@ -26,6 +26,9 @@ pub(crate) struct Function {
     /// the kernel prepares into a shared overflow slot). 0 = only the last key is kept.
     pub(crate) prep_slots: u32,
     pub(crate) prep_seen: std::sync::Mutex<Vec<u64>>,
+    /// d4r phase kernels NAME_post1.. launched after the main kernel, on the same stream with the same
+    /// parameters: (function, grid x, grid y, block x, block y, block z); a grid entry of 0 keeps the launch's value
+    pub(crate) post: Vec<(hipFunction_t, u32, u32, u32, u32, u32)>,
 }
 
 impl<'a, E: zluda_common::CudaErrorType> zluda_common::FromCuda<'a, CUfunction, E>
@@ -220,7 +223,25 @@ pub(crate) fn launch_kernel(
             kernel_params,
             extra_for_hip,
         )
+    }?;
+    for &(post, gx, gy, bx, by, bz) in f.post.iter() {
+        unsafe {
+            hipModuleLaunchKernel(
+                post,
+                if gx != 0 { gx } else { grid_dim_x },
+                if gy != 0 { gy } else { grid_dim_y },
+                if gx != 0 || gy != 0 { 1 } else { grid_dim_z },
+                bx,
+                by,
+                bz,
+                0,
+                stream,
+                kernel_params,
+                extra_for_hip,
+            )
+        }?;
     }
+    Ok(())
 }
 
