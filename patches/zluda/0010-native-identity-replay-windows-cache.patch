new file mode 100644
index 0000000..875b2e3
--- /dev/null
+++ b/zluda/src/impl/d4r_replay.rs
@@ -0,0 +1,109 @@
+//! Opt-in, synchronous diagnostic captures. Never enabled in the game fast path.
+//! Captures can contain proprietary network weights; keep them out of releases.
+use hip_runtime_sys::*;
+use std::{collections::HashMap, ffi::{c_void, CStr}, fs, path::PathBuf, sync::{Mutex, OnceLock}};
+
+struct Config { directory: PathBuf, filter: String, limit: u32 }
+static CONFIG: OnceLock<Option<Config>> = OnceLock::new();
+static COUNTS: OnceLock<Mutex<HashMap<String, u32>>> = OnceLock::new();
+
+pub(crate) struct Capture { directory: PathBuf, allocations: Vec<(usize, usize)> }
+
+fn io_error(error: impl std::fmt::Display) -> hipErrorCode_t {
+    eprintln!("[d4r-replay] capture failed: {error}");
+    hipErrorCode_t::r#Unknown
+}
+
+impl Capture {
+    fn save(&self, destination: &std::path::Path) -> hipError_t {
+        fs::create_dir_all(destination).map_err(io_error)?;
+        for (id, &(base, size)) in self.allocations.iter().enumerate() {
+            let mut bytes = vec![0u8; size];
+            unsafe { hipMemcpyDtoH(bytes.as_mut_ptr().cast(), hipDeviceptr_t(base as *mut c_void), size) }?;
+            fs::write(destination.join(format!("alloc-{id}.bin")), bytes).map_err(io_error)?;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn finish(self, stream: hipStream_t) -> hipError_t {
+        unsafe { hipStreamSynchronize(stream) }?;
+        self.save(&self.directory.join("gpu-output"))?;
+        eprintln!("[d4r-replay] complete path={}", self.directory.display());
+        Ok(())
+    }
+}
+
+pub(crate) unsafe fn begin(
+    name: &CStr, stream: hipStream_t, parameters: *mut *mut c_void,
+    extra: *mut *mut c_void, launch: [u32; 7],
+) -> Result<Option<Capture>, hipErrorCode_t> {
+    let Some(config) = CONFIG.get_or_init(|| std::env::var_os("D4R_CUDA_REPLAY_DUMP_DIR").map(|directory| Config {
+        directory: directory.into(),
+        filter: std::env::var("D4R_CUDA_REPLAY_DUMP_FILTER").unwrap_or_default(),
+        limit: std::env::var("D4R_CUDA_REPLAY_DUMP_LIMIT").ok().and_then(|s| s.parse().ok()).unwrap_or(1),
+    })) else { return Ok(None) };
+    let name = name.to_str().map_err(io_error)?;
+    // Only the audited, single 176-byte K argument ABI is captured here.
+    if !name.starts_with("dltss_pwin_") || !name.ends_with("_layer") || !name.contains(&config.filter) {
+        return Ok(None);
+    }
+    let mut block = std::ptr::null::<u8>();
+    let mut bytes = None;
+    if !extra.is_null() {
+        for i in (0..6).step_by(2) {
+            match *extra.add(i) as usize {
+                1 => block = (*extra.add(i + 1)).cast(),
+                2 => bytes = Some(*(*extra.add(i + 1) as *const usize)),
+                0 => break,
+                _ => return Err(hipErrorCode_t::r#InvalidValue),
+            }
+        }
+    } else if !parameters.is_null() {
+        block = (*parameters).cast();
+        bytes = Some(176);
+    }
+    if block.is_null() || bytes != Some(176) {
+        return Err(io_error(format!("unexpected K parameter ABI for {name}: {bytes:?}")));
+    }
+    let sequence = {
+        let mut counts = COUNTS.get_or_init(|| Mutex::new(HashMap::new())).lock().map_err(io_error)?;
+        let count = counts.entry(name.to_owned()).or_default();
+        if *count >= config.limit { return Ok(None); }
+        *count += 1;
+        *count
+    };
+    hipStreamSynchronize(stream)?;
+    let arguments = std::slice::from_raw_parts(block, 176);
+    let directory = config.directory.join(format!("replay-{sequence:06}-{name}"));
+    fs::create_dir_all(&directory).map_err(io_error)?;
+    fs::write(directory.join("args.bin"), arguments).map_err(io_error)?;
+    let mut manifest = format!("kernel {name}\nlaunch {} {} {} {} {} {} {}\nargs 176\n",
+        launch[0], launch[1], launch[2], launch[3], launch[4], launch[5], launch[6]);
+    let mut allocations = Vec::<(usize, usize)>::new();
+    for offset in (0..176).step_by(8) {
+        let pointer = u64::from_le_bytes(arguments[offset..offset + 8].try_into().unwrap()) as usize;
+        if pointer == 0 { continue; }
+        let mut base = hipDeviceptr_t(std::ptr::null_mut());
+        let mut size = 0;
+        if hipMemGetAddressRange(&mut base, &mut size, hipDeviceptr_t(pointer as *mut c_void)).is_err() { continue; }
+        let base = base.0 as usize;
+        if pointer < base || pointer - base >= size { continue; }
+        if size > 512 * 1024 * 1024 { return Err(io_error("allocation exceeds diagnostic 512 MiB limit")); }
+        let id = match allocations.iter().position(|&(b, _)| b == base) {
+            Some(id) => id,
+            None => {
+                let id = allocations.len();
+                allocations.push((base, size));
+                manifest.push_str(&format!("alloc {id} 0x{base:x} {size}\n"));
+                id
+            }
+        };
+        manifest.push_str(&format!("pointer {offset} {id} {}\n", pointer - base));
+    }
+    if allocations.is_empty() { return Err(io_error("no K allocation pointers resolved")); }
+    fs::write(directory.join("manifest.txt"), manifest).map_err(io_error)?;
+    let capture = Capture { directory, allocations };
+    capture.save(&capture.directory)?;
+    eprintln!("[d4r-replay] begin kernel={name} allocations={} path={}", capture.allocations.len(), capture.directory.display());
+    Ok(Some(capture))
+}
