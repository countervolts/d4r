+extern "C"
+{
+    wmma_uint8 FUNC(d4r_wmma12_t_a_from_b)(uint2::Native_vec_ b)
+    {
+        __builtin_amdgcn_sched_barrier(0);
+        uint32_t n = wmma_lane() % 16;
+        wmma_uint8 result = {};
+        for (uint32_t j = 0; j < 4; j++)
+        {
+            uint32_t value = wmma_from_lane((n % 8) * 4 + (j >> 1) + 2 * wmma12_half(), (j & 1) ? b.y : b.x);
