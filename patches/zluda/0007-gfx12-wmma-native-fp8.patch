+    return high ? uint4::Native_vec_{recv.x, recv.y, odd.x, odd.y} : uint4::Native_vec_{even.x, even.y, recv.x, recv.y};
+}
+
+// the same for f32 shadows (element v = row 2v + h)
+__device__ static wmma_float8 wmma12_c_from_s(wmma_float4 c)
+{
+    wmma_float4 o;
+    for (uint32_t v = 0; v < 4; v++)
+        o[v] = wmma12_other_half_f(c[v]);
+    return {c[0], o[0], c[1], o[1], c[2], o[2], c[3], o[3]};
+}
+
+__device__ static wmma_float8 wmma12_c_from_s_pair(wmma_float4 c0, wmma_float4 c1)
+{
+    const bool high = wmma12_half() != 0;
+    wmma_float8 r;
+    for (uint32_t v = 0; v < 4; v++)
+    {
+        const float own = high ? c1[v] : c0[v], recv = wmma12_other_half_f(high ? c0[v] : c1[v]);
+        r[2 * v] = high ? recv : own;
+        r[2 * v + 1] = high ? own : recv;
+    }
+    return r;
+}
+
+__device__ static wmma_float4 wmma12_s_from_d(wmma_float8 d)
+{
+    const bool high = wmma12_half() != 0;
+    wmma_float4 r;
+    for (uint32_t v = 0; v < 4; v++)
+    {
+        const float odd = wmma12_other_half_f(d[2 * v + 1]);
+        r[v] = high ? odd : d[2 * v];
+    }
+    return r;
+}
+
+__device__ static wmma_float8 wmma12_s_from_d_pair(wmma_float8 d)
+{
+    const bool high = wmma12_half() != 0;
+    wmma_float8 r;
+    for (uint32_t v = 0; v < 4; v++)
+    {
+        const float recv = wmma12_other_half_f(high ? d[2 * v] : d[2 * v + 1]);
+        r[v] = high ? recv : d[2 * v];
+        r[4 + v] = high ? d[2 * v + 1] : recv;
+    }
+    return r;
+}
