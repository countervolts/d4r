+// r >= 8 take `high` from lane 4(r - 8) + t (t = 2h + (j >> 1)). The source lane is in the first half-wave,
+// while t differs between the two destination half-waves, so the two candidates must be gathered independently.
+__device__ static uint32_t wmma12_gather2(uint32_t low, uint32_t high, uint32_t j)
+{
+    const uint32_t row = wmma_lane() % 16;
+    const uint32_t t = (j >> 1) + 2 * wmma12_half();
+    const uint32_t lo = wmma_from_lane(row * 4 + t, low);
+    const uint32_t hi = wmma_from_lane((row % 8) * 4 + t, high);
+    return row < 8 ? lo : hi;
