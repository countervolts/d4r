@@ -974,6 +974,24 @@
 unsigned LLVMZludaRewriteMmaF16Wmma(LLVMModuleRef ModuleRef, unsigned Flags)
 {
     Module *M = unwrap(ModuleRef);
+    if ((Flags & 6) == 6)
+    {
+        for (const char *Name : {"cvt_rn_satfinite_e4m3x2_f16x2",
+                                "cvt_rn_satfinite_relu_e4m3x2_f16x2"})
+        {
+            Function *Original = M->getFunction(std::string("__zluda_ptx_impl_") + Name);
+            if (Original == nullptr)
+                continue;
+            FunctionCallee Native = M->getOrInsertFunction(
+                std::string("__zluda_ptx_impl_d4r_") + Name, Original->getFunctionType());
+            SmallVector<CallInst *, 32> Calls;
+            for (User *U : Original->users())
+                if (auto *Call = dyn_cast<CallInst>(U))
+                    Calls.push_back(Call);
+            for (CallInst *Call : Calls)
+                Call->setCalledFunction(Native);
+        }
+    }
     // D4R_ZLUDA_WMMA_K8=0 keeps m16n8k8 on the dot-product fallback
     if (const char *K8Env = getenv("D4R_ZLUDA_WMMA_K8"); K8Env == nullptr || K8Env[0] != '0')
         widenMmaK8(M);
