+    // Selected only for gfx12 native-FP8 modules by the WMMA rewrite. This
+    // declaration leaves the architecture-specific intrinsic dormant in the
+    // shared gfx1030-built device library on other targets.
+    __device__ uint32_t d4r_cvt_pk_fp8_f32(float, float, uint32_t, bool)
+        __asm("llvm.amdgcn.cvt.pk.fp8.f32");
+
+    Fp8x2 FUNC(d4r_cvt_rn_satfinite_e4m3x2_f16x2)(__half2 input)
+    {
+        typedef _Float16 half_vector __attribute__((ext_vector_type(2)));
+        typedef uint16_t magnitude_vector __attribute__((ext_vector_type(2)));
+        const uint32_t bits = std::bit_cast<uint32_t>(input);
+        // Positive half encodings are ordered by magnitude. Clamp both lanes
+        // with one packed integer min, then retain NaNs as positive quiet NaNs.
+        // Restore original signs after conversion, including negative zero.
+        const magnitude_vector magnitude = std::bit_cast<magnitude_vector>(bits & 0x7fff7fffu);
+        const magnitude_vector saturated =
+            __builtin_elementwise_min(magnitude, magnitude_vector{0x5f00u, 0x5f00u});
+        const magnitude_vector kept{
+            magnitude[0] > 0x7c00u ? uint16_t(0x7e00u) : saturated[0],
+            magnitude[1] > 0x7c00u ? uint16_t(0x7e00u) : saturated[1]};
+        const half_vector halves = std::bit_cast<half_vector>(kept);
+        const float x = float(halves[0]), y = float(halves[1]);
+        const uint32_t encoded = d4r_cvt_pk_fp8_f32(x, y, 0, false);
+        // AMD canonicalizes NaNs to 0xff. PTX retains each input's sign.
+        const uint16_t packed = uint16_t((encoded & 0x7f7fu) |
+                                        ((bits >> 8) & 0x80u) | ((bits >> 16) & 0x8000u));
+        return std::bit_cast<Fp8x2>(packed);
+    }
+
+    Fp8x2 FUNC(d4r_cvt_rn_satfinite_relu_e4m3x2_f16x2)(__half2 input)
+    {
+        return FUNC_CALL(d4r_cvt_rn_satfinite_e4m3x2_f16x2)(relu_keep_nan_halves(input));
+    }
