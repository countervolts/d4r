--- a/llvm_zluda/build.rs
+++ b/llvm_zluda/build.rs
@@ -116,15 +116,24 @@
 // We resort to this garbage because Cargo is ideologically opposed to
 // being useful, see here: https://github.com/rust-lang/cargo/issues/11054
 fn try_get_build_profile_name() -> String {
+    // Walk up from OUT_DIR until a directory naming a build profile turns up, rather than popping
+    // a fixed number of times. Cargo has added levels to the target/<profile>/build/<crate>/<hash>
+    // /out layout more than once (current Cargo emits build/<crate>/<hash>/out), and each time it
+    // does, the fixed count lands on "build" rather than the profile and panics with
+    // "Unknown build profile: build". Stopping at the first ancestor whose name is a profile this
+    // script knows survives that.
+    const PROFILES: [&str; 4] = ["debug", "dev-llvm", "release", "release-lto"];
     let mut path = PathBuf::from(env::var("OUT_DIR").unwrap());
-    path.pop();
-    path.pop();
-    path.pop();
-    let name = path.file_name().unwrap().to_str().unwrap();
-    if !["debug", "dev-llvm", "release", "release-lto"].contains(&name) {
-        panic!("Unknown build profile: {}", name);
-    }
-    name.to_string()
+    loop {
+        if let Some(name) = path.file_name().and_then(|name| name.to_str()) {
+            if PROFILES.contains(&name) {
+                return name.to_string();
+            }
+        }
+        if !path.pop() {
+            panic!("no build profile directory above OUT_DIR");
+        }
+    }
 }
 
