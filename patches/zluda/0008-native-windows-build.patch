+#if defined(_WIN32) || defined(_WIN64)
+        // HIP on Windows only supplies the wide _wassert entry point. Keep the
+        // CUDA assertion's ASCII diagnostics and trap through public OCKL APIs.
+        auto output = __ockl_fprintf_stderr_begin();
+        const char* parts[] = {"CUDA assertion: ", (const char*)message, " at ", (const char*)file,
+                               " in ", (const char*)function, "\n"};
+        for (const char* part : parts) {
+            const char* end = part;
+            while (*end) ++end;
+            output = __ockl_fprintf_append_string_n(output, part, end - part, 0);
+        }
+        __ockl_fprintf_append_args(output, 1, line, 0, 0, 0, 0, 0, 0, 1);
+        __builtin_trap();
+#else
