+
+fn link_prebuilt_llvm(llvm_build_path: &PathBuf) {
     let (cxxflags, ldflags, libdir, lib_names, system_libs) =
         llvm_config(&llvm_build_path.join("bin/llvm-config")).unwrap();
     println!("cargo:rustc-link-arg={ldflags}");
     println!("cargo:rustc-link-search=native={libdir}");
     for lib in system_libs.split_ascii_whitespace() {
-        println!("cargo:rustc-link-arg={lib}");
+        if let Some(name) = lib.strip_prefix("-l") {
+            println!("cargo:rustc-link-lib={name}");
+        } else {
+            println!("cargo:rustc-link-arg={lib}");
+        }
+    }
+    // llvm-config omits system libraries on Windows. Propagate these through
+    // this rlib to its final cdylib consumer (link-arg alone cannot do that).
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() == Ok("windows") {
+        for library in ["psapi", "shell32", "ole32", "uuid", "advapi32", "ws2_32", "ntdll"] {
+            println!("cargo:rustc-link-lib={library}");
+        }
     }
     link_lld_components();
     link_llvm_components(lib_names);
     compile_cxx_lib(cxxflags, &llvm_build_path);
 }
