+// gfx11 WMMA lowering of mma.sync.aligned.m16n8k16.row.col.f16.f16.f16.f16,
+// run on ZLUDA's emitted module before linking, while PTX registers are still
+// allocas. Each MMA becomes
+//   d = d4r_wmma_t_to_nv(d4r_wmma_t_mma_f16(a_from_b(B), b_from_a(A), C'))
+// (see zluda_ptx_impl.cpp for the layouts). Register pairs used as MMA
+// accumulators get a shadow alloca holding the pair in WMMA layout: an MMA
+// whose C is a plain load of such a pair reads the shadow, an MMA whose D is
+// stored to it writes the shadow, and any other store to either register
+// refreshes the shadow with d4r_wmma_t_from_nv. The invariant "shadow ==
+// WMMA layout of the pair" thus holds at every program point, and once
+// mem2reg promotes the allocas the layout conversions between chained MMAs
+// become dead code. Returns the number of MMAs rewritten.
+namespace
+{
+constexpr const char *kMmaF16 = "__zluda_ptx_impl_mma_sync_aligned_m16n8k16_row_col_f16_f16_f16_f16";
+
+struct RegisterPair
+{
+    AllocaInst *Low = nullptr;
+    AllocaInst *High = nullptr;
+    bool operator==(const RegisterPair &Other) const { return Low == Other.Low && High == Other.High; }
+};
+
+// Only allocas used purely as the address of loads and stores are tracked.
+static bool isPlainRegister(AllocaInst *Alloca)
+{
+    for (User *U : Alloca->users())
+    {
+        if (isa<LoadInst>(U))
+            continue;
+        auto *Store = dyn_cast<StoreInst>(U);
+        if (Store == nullptr || Store->getPointerOperand() != Alloca)
+            return false;
+    }
+    return true;
+}
+
+// Matches insertelement(insertelement(undef, load Low, 0), load High, 1) where
+// the loads sit in the call's block with no store to either register between
+// them and the call.
+static bool matchLoadedPair(Value *Vector, CallInst *Call, RegisterPair &Pair)
+{
+    auto *Second = dyn_cast<InsertElementInst>(Vector);
+    if (Second == nullptr)
+        return false;
+    auto *First = dyn_cast<InsertElementInst>(Second->getOperand(0));
+    auto *SecondIndex = dyn_cast<ConstantInt>(Second->getOperand(2));
+    if (First == nullptr || SecondIndex == nullptr || SecondIndex->getZExtValue() != 1)
+        return false;
+    auto *FirstIndex = dyn_cast<ConstantInt>(First->getOperand(2));
+    if (FirstIndex == nullptr || FirstIndex->getZExtValue() != 0 || !isa<UndefValue>(First->getOperand(0)))
+        return false;
+    auto *LowLoad = dyn_cast<LoadInst>(First->getOperand(1));
+    auto *HighLoad = dyn_cast<LoadInst>(Second->getOperand(1));
+    if (LowLoad == nullptr || HighLoad == nullptr || LowLoad->getParent() != Call->getParent() ||
+        HighLoad->getParent() != Call->getParent())
+        return false;
+    Pair.Low = dyn_cast<AllocaInst>(LowLoad->getPointerOperand());
+    Pair.High = dyn_cast<AllocaInst>(HighLoad->getPointerOperand());
+    if (Pair.Low == nullptr || Pair.High == nullptr || Pair.Low == Pair.High ||
+        !Pair.Low->getAllocatedType()->isIntegerTy(32) || !Pair.High->getAllocatedType()->isIntegerTy(32) ||
+        !isPlainRegister(Pair.Low) || !isPlainRegister(Pair.High))
+        return false;
+    Instruction *Earliest = LowLoad->comesBefore(HighLoad) ? LowLoad : HighLoad;
+    for (Instruction *I = Earliest->getNextNode(); I != Call; I = I->getNextNode())
+        if (auto *Store = dyn_cast<StoreInst>(I))
+            if (Store->getPointerOperand() == Pair.Low || Store->getPointerOperand() == Pair.High)
+                return false;
+    return true;
+}
+
+// Finds the stores of both lanes of an MMA result into a register pair.
+static bool matchStoredPair(CallInst *Call, RegisterPair &Pair, StoreInst *Stores[2])
+{
+    Stores[0] = Stores[1] = nullptr;
+    for (User *U : Call->users())
+    {
+        auto *Extract = dyn_cast<ExtractElementInst>(U);
+        auto *Index = Extract != nullptr ? dyn_cast<ConstantInt>(Extract->getIndexOperand()) : nullptr;
+        if (Index == nullptr || Index->getZExtValue() > 1 || !Extract->hasOneUse())
+            return false;
+        auto *Store = dyn_cast<StoreInst>(Extract->user_back());
+        if (Store == nullptr || Store->getValueOperand() != Extract || Stores[Index->getZExtValue()] != nullptr)
+            return false;
+        Stores[Index->getZExtValue()] = Store;
+    }
+    if (Stores[0] == nullptr || Stores[1] == nullptr)
+        return false;
+    Pair.Low = dyn_cast<AllocaInst>(Stores[0]->getPointerOperand());
+    Pair.High = dyn_cast<AllocaInst>(Stores[1]->getPointerOperand());
+    return Pair.Low != nullptr && Pair.High != nullptr && Pair.Low != Pair.High;
+}
+
+// Matches an N-element vector built as a chain of insertelements (indices
+// 0..N-1 into undef) of loads from plain i32 registers; returns the registers.
+static bool matchLoadedVector(Value *Vector, unsigned Elements, SmallVectorImpl<AllocaInst *> &Registers)
+{
+    Registers.assign(Elements, nullptr);
+    for (unsigned Remaining = Elements; Remaining > 0; --Remaining)
+    {
+        auto *Insert = dyn_cast<InsertElementInst>(Vector);
+        auto *Index = Insert != nullptr ? dyn_cast<ConstantInt>(Insert->getOperand(2)) : nullptr;
+        if (Index == nullptr || Index->getZExtValue() != Remaining - 1)
+            return false;
+        auto *Load = dyn_cast<LoadInst>(Insert->getOperand(1));
+        auto *Register = Load != nullptr ? dyn_cast<AllocaInst>(Load->getPointerOperand()) : nullptr;
+        if (Register == nullptr || !Register->getAllocatedType()->isIntegerTy(32) || !isPlainRegister(Register))
+            return false;
+        Registers[Remaining - 1] = Register;
+        Vector = Insert->getOperand(0);
+    }
+    return isa<UndefValue>(Vector);
+}
+
+// The registers are plain allocas (only loaded and stored directly), so only
+// explicit stores can change them.
+static bool storesBetween(Instruction *From, Instruction *To, ArrayRef<AllocaInst *> Registers)
+{
+    for (Instruction *I = From->getNextNode(); I != nullptr && I != To; I = I->getNextNode())
+        if (auto *Store = dyn_cast<StoreInst>(I))
+            if (is_contained(Registers, Store->getPointerOperand()))
+                return true;
+    return false;
+}
+
+struct Helpers
+{
+    FunctionCallee AFromB, BFromA, Mma, FromNv, ToNv, AFromBPair, MmaPair;
+};
+
+static Value *loadPair(IRBuilder<> &Builder, const RegisterPair &Pair)
+{
+    Type *I32 = Builder.getInt32Ty();
+    Value *Vector = UndefValue::get(FixedVectorType::get(I32, 2));
+    Vector = Builder.CreateInsertElement(Vector, Builder.CreateLoad(I32, Pair.Low), Builder.getInt8(0));
+    return Builder.CreateInsertElement(Vector, Builder.CreateLoad(I32, Pair.High), Builder.getInt8(1));
+}
+
+static unsigned rewriteFunction(Function &F, Function *Mma, const Helpers &H)
+{
+    SmallVector<CallInst *, 64> Calls;
+    for (Instruction &I : instructions(F))
+        if (auto *Call = dyn_cast<CallInst>(&I))
+            if (Call->getCalledFunction() == Mma && Call->arg_size() == 3)
+                Calls.push_back(Call);
+    if (Calls.empty())
+        return 0;
+
+    struct Site
+    {
+        CallInst *Call;
+        bool HasC;
+        RegisterPair C;
+        bool HasD;
+        RegisterPair D;
+        StoreInst *DStores[2];
+    };
+    SmallVector<Site, 64> Sites;
+    for (CallInst *Call : Calls)
+    {
+        Site S{Call, false, {}, false, {}, {nullptr, nullptr}};
+        S.HasC = matchLoadedPair(Call->getArgOperand(2), Call, S.C);
+        S.HasD = matchStoredPair(Call, S.D, S.DStores);
+        Sites.push_back(S);
+    }
+
+    // Accumulator pairs whose registers belong to no other pair are replaced
+    // outright by a shadow in WMMA layout.
+    SmallVector<RegisterPair, 32> Shadowed;
+    DenseMap<AllocaInst *, int> Owner; // register -> shadow index, -1 if ambiguous
+    auto consider = [&](const RegisterPair &Pair) {
+        for (const RegisterPair &Known : Shadowed)
+            if (Known == Pair)
+                return;
+        int Index = static_cast<int>(Shadowed.size());
+        for (AllocaInst *Member : {Pair.Low, Pair.High})
+        {
+            auto Found = Owner.find(Member);
+            if (Found != Owner.end())
+                Found->second = -1;
+            else
+                Owner[Member] = Index;
+        }
+        Shadowed.push_back(Pair);
+    };
+    for (const Site &S : Sites)
+        if (S.HasC)
+            consider(S.C);
+    auto shadowOf = [&](const RegisterPair &Pair) -> int {
+        auto Low = Owner.find(Pair.Low);
+        auto High = Owner.find(Pair.High);
+        if (Low == Owner.end() || High == Owner.end() || Low->second < 0 || Low->second != High->second)
+            return -1;
+        return Shadowed[Low->second] == Pair ? Low->second : -1;
+    };
+
+    Type *Pair32 = FixedVectorType::get(Type::getInt32Ty(F.getContext()), 2);
+    SmallVector<AllocaInst *, 32> Shadows;
+    {
+        IRBuilder<> Builder(&*F.getEntryBlock().getFirstInsertionPt());
+        for (size_t Index = 0; Index < Shadowed.size(); ++Index)
+            Shadows.push_back(
+                shadowOf(Shadowed[Index]) == static_cast<int>(Index)
+                    ? Builder.CreateAlloca(Pair32, Shadowed[Index].Low->getAddressSpace(), nullptr, "wmma.shadow")
+                    : nullptr);
+    }
+    auto shadowFor = [&](const RegisterPair &Pair) -> AllocaInst * {
+        int Index = shadowOf(Pair);
+        return Index >= 0 ? Shadows[Index] : nullptr;
+    };
+
+    // Snapshot every access to shadowed registers before rewriting anything.
+    SmallVector<LoadInst *, 64> Loads;
+    SmallVector<StoreInst *, 64> Stores;
+    for (auto &[Register, Index] : Owner)
+    {
+        if (Index < 0 || Shadows[Index] == nullptr)
+            continue;
+        for (User *U : Register->users())
+        {
+            if (auto *Load = dyn_cast<LoadInst>(U))
+                Loads.push_back(Load);
+            else
+                Stores.push_back(cast<StoreInst>(U));
+        }
+    }
+    DenseSet<StoreInst *> ResultStores; // MMA result stores replaced by shadow stores
+
+    auto accumulator = [&](const Site &S, IRBuilder<> &Builder) -> Value * {
+        if (S.HasC)
+            if (AllocaInst *Shadow = shadowFor(S.C))
+                return Builder.CreateLoad(Pair32, Shadow);
+        return Builder.CreateCall(H.FromNv, {S.Call->getArgOperand(2)});
+    };
+    auto finish = [&](const Site &S, Value *D, IRBuilder<> &Builder) {
+        if (S.HasD)
+            if (AllocaInst *Shadow = shadowFor(S.D))
+            {
+                // The result goes to the shadow where its register stores were.
+                StoreInst *Last = S.DStores[0]->comesBefore(S.DStores[1]) ? S.DStores[1] : S.DStores[0];
+                IRBuilder<> At(Last);
+                At.CreateStore(D, Shadow);
+                ResultStores.insert(S.DStores[0]);
+                ResultStores.insert(S.DStores[1]);
+            }
+        return Builder.CreateCall(H.ToNv, {D});
+    };
+    // Two MMAs that share A (same registers, no store in between to anything
+    // the second one reads) run as one 16x16x16 WMMA placed at the first.
+    auto pairable = [&](const Site &First, const Site &Second) {
+        SmallVector<AllocaInst *, 4> AFirst, ASecond, BSecond;
+        if (First.Call->getParent() != Second.Call->getParent() || !Second.HasC ||
+            shadowFor(Second.C) == nullptr || !First.Call->comesBefore(Second.Call) ||
+            !matchLoadedVector(First.Call->getArgOperand(0), 4, AFirst) ||
+            !matchLoadedVector(Second.Call->getArgOperand(0), 4, ASecond) || AFirst != ASecond ||
+            !matchLoadedVector(Second.Call->getArgOperand(1), 2, BSecond))
+            return false;
+        // The second B is reloaded at the first MMA, so it must not live in a
+        // shadow (those registers are no longer kept up to date).
+        for (AllocaInst *Register : BSecond)
+        {
+            auto Found = Owner.find(Register);
+            if (Found != Owner.end() && Found->second >= 0 && Shadows[Found->second] != nullptr)
+                return false;
+        }
+        SmallVector<AllocaInst *, 8> Read(AFirst.begin(), AFirst.end());
+        Read.append(BSecond.begin(), BSecond.end());
+        Read.push_back(Second.C.Low);
+        Read.push_back(Second.C.High);
+        return !storesBetween(First.Call, Second.Call, Read);
+    };
+    for (size_t Index = 0; Index < Sites.size(); ++Index)
+    {
+        const Site &S = Sites[Index];
+        CallInst *Call = S.Call;
+        IRBuilder<> Builder(Call);
+        Value *BTransposed = Builder.CreateCall(H.BFromA, {Call->getArgOperand(0)});
+        if (Index + 1 < Sites.size() && pairable(S, Sites[Index + 1]))
+        {
+            const Site &Next = Sites[Index + 1];
+            SmallVector<AllocaInst *, 2> BNext;
+            matchLoadedVector(Next.Call->getArgOperand(1), 2, BNext);
+            Value *B1 = loadPair(Builder, RegisterPair{BNext[0], BNext[1]});
+            Value *ATransposed = Builder.CreateCall(H.AFromBPair, {Call->getArgOperand(1), B1});
+            Value *C0 = accumulator(S, Builder);
+            Value *C1 = accumulator(Next, Builder);
+            Value *D = Builder.CreateCall(H.MmaPair, {ATransposed, BTransposed, C0, C1});
+            Value *D0 = Builder.CreateShuffleVector(D, ArrayRef<int>{0, 1});
+            Value *D1 = Builder.CreateShuffleVector(D, ArrayRef<int>{2, 3});
+            Call->replaceAllUsesWith(finish(S, D0, Builder));
+            Next.Call->replaceAllUsesWith(finish(Next, D1, Builder));
+            Call->eraseFromParent();
+            Next.Call->eraseFromParent();
+            ++Index;
+            continue;
+        }
+        Value *ATransposed = Builder.CreateCall(H.AFromB, {Call->getArgOperand(1)});
+        Value *D = Builder.CreateCall(H.Mma, {ATransposed, BTransposed, accumulator(S, Builder)});
+        Call->replaceAllUsesWith(finish(S, D, Builder));
+        Call->eraseFromParent();
+    }
+
+    // Every other access now goes through the shadow.
+    for (LoadInst *Load : Loads)
+    {
+        auto *Register = cast<AllocaInst>(Load->getPointerOperand());
+        const RegisterPair &Pair = Shadowed[Owner[Register]];
+        IRBuilder<> Builder(Load);
+        Value *Nv = Builder.CreateCall(H.ToNv, {Builder.CreateLoad(Pair32, shadowFor(Pair))});
+        Load->replaceAllUsesWith(Builder.CreateExtractElement(Nv, Builder.getInt8(Register == Pair.High)));
+        Load->eraseFromParent();
+    }
+    for (StoreInst *Store : Stores)
+    {
+        if (!ResultStores.contains(Store))
+        {
+            auto *Register = cast<AllocaInst>(Store->getPointerOperand());
+            const RegisterPair &Pair = Shadowed[Owner[Register]];
+            AllocaInst *Shadow = shadowFor(Pair);
+            IRBuilder<> Builder(Store);
+            Value *Nv = Builder.CreateCall(H.ToNv, {Builder.CreateLoad(Pair32, Shadow)});
+            Nv = Builder.CreateInsertElement(Nv, Store->getValueOperand(), Builder.getInt8(Register == Pair.High));
+            Builder.CreateStore(Builder.CreateCall(H.FromNv, {Nv}), Shadow);
+        }
+        auto *Operand = dyn_cast<Instruction>(Store->getValueOperand());
+        Store->eraseFromParent();
+        if (Operand != nullptr && Operand->use_empty() && !Operand->mayHaveSideEffects())
+            Operand->eraseFromParent();
+    }
+    return Calls.size();
+}
+} // namespace
+
+unsigned LLVMZludaRewriteMmaF16Wmma(LLVMModuleRef ModuleRef)
+{
+    Module *M = unwrap(ModuleRef);
+    Function *Mma = M->getFunction(kMmaF16);
+    if (Mma == nullptr || Mma->use_empty())
+        return 0;
+    LLVMContext &Context = M->getContext();
+    Type *I32 = Type::getInt32Ty(Context);
+    Type *V2 = FixedVectorType::get(I32, 2);
+    Type *V4 = FixedVectorType::get(I32, 4);
+    Type *V8 = FixedVectorType::get(I32, 8);
+    AttributeList Attributes = AttributeList::get(Context, AttributeList::FunctionIndex,
+                                                  AttrBuilder(Context, Mma->getAttributes().getFnAttrs()));
+    Helpers H;
+    H.AFromB = M->getOrInsertFunction("__zluda_ptx_impl_d4r_wmma_t_a_from_b", Attributes, V8, V2);
+    H.BFromA = M->getOrInsertFunction("__zluda_ptx_impl_d4r_wmma_t_b_from_a", Attributes, V8, V4);
+    H.Mma = M->getOrInsertFunction("__zluda_ptx_impl_d4r_wmma_t_mma_f16", Attributes, V2, V8, V8, V2);
+    H.FromNv = M->getOrInsertFunction("__zluda_ptx_impl_d4r_wmma_t_from_nv", Attributes, V2, V2);
+    H.ToNv = M->getOrInsertFunction("__zluda_ptx_impl_d4r_wmma_t_to_nv", Attributes, V2, V2);
+    H.AFromBPair = M->getOrInsertFunction("__zluda_ptx_impl_d4r_wmma_t_a_from_b_pair", Attributes, V8, V2, V2);
+    H.MmaPair = M->getOrInsertFunction("__zluda_ptx_impl_d4r_wmma_t_mma_f16_pair", Attributes, V4, V8, V8, V2, V2);
+    unsigned Rewritten = 0;
+    for (Function &F : *M)
+        if (!F.isDeclaration())
+            Rewritten += rewriteFunction(F, Mma, H);
+    return Rewritten;
+}
