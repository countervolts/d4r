 template <typename T, typename A, typename B, int BOffset, typename OcklFunc>
 __device__ T dp2a_impl(T a, T b, T c, OcklFunc ockl_func)
 {
diff --git a/zluda_common/examples/d4r_fatbin_ptx.rs b/zluda_common/examples/d4r_fatbin_ptx.rs
new file mode 100644
index 0000000..50f7a09
--- /dev/null
+++ b/zluda_common/examples/d4r_fatbin_ptx.rs
@@ -0,0 +1,36 @@
+// Extracts (and decompresses) every PTX file from captured CUDA fatbin images.
+// usage: d4r_fatbin_ptx <outdir> <image>...
+use cuda_types::dark_api::FatbinFileHeader;
+use std::{env, fs, path::PathBuf};
+use zluda_common::{CodeLibraryRef, CodeModuleRef};
+
+fn main() {
+    let mut args = env::args().skip(1);
+    let outdir = PathBuf::from(args.next().expect("output directory"));
+    fs::create_dir_all(&outdir).expect("create output directory");
+    for path in args {
+        let mut bytes = fs::read(&path).expect("read image");
+        bytes.extend_from_slice(&[0; 16]);
+        let stem = PathBuf::from(&path).file_stem().unwrap().to_string_lossy().into_owned();
+        let library = unsafe { CodeLibraryRef::try_load(bytes.as_ptr().cast()) }.expect("load image");
+        let mut count = 0;
+        unsafe {
+            library.iterate_modules(|_, module| {
+                let text = match module {
+                    Ok(CodeModuleRef::Text(ptx)) => Some(ptx.to_string()),
+                    Ok(CodeModuleRef::File(file)) if file.header.kind == FatbinFileHeader::HEADER_KIND_PTX => file
+                        .get_or_decompress_content(true)
+                        .ok()
+                        .map(|content| String::from_utf8_lossy(&content).trim_end_matches('\0').to_string()),
+                    _ => None,
+                };
+                if let Some(text) = text {
+                    let name = outdir.join(format!("{stem}-{count:02}.ptx"));
+                    fs::write(&name, text).expect("write PTX");
+                    count += 1;
+                }
+            })
+        };
+        println!("{path}: {count} PTX modules");
+    }
+}
