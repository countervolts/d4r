+// Correctness baseline for f16-accumulator MMAs. f32 WMMA accumulation may
+// reach the other f16 neighbour around cancellation-heavy rounding midpoints.
+// Keep the existing gfx12 gathers/layout; sum their f16 operands in f64 and
+// round directly to f16 once, matching d4r's independent NumPy/PTX reference.
+// The e4m3 and f32-shadow paths continue using native WMMA.
+__device__ static double wmma12_half_value(uint32_t bits)
+{
+    const uint32_t magnitude = bits & 0x7fffu, exponent = magnitude >> 10;
+    const double value = exponent == 0 ? double(magnitude) * 0x1p-24 :
+        double(std::bit_cast<float>(exponent == 31 ? (0x7f800000u | ((magnitude & 1023u) << 13)) :
+                                     ((magnitude << 13) + 0x38000000u)));
+    return bits & 0x8000u ? -value : value;
+}
+
+// Preserve f16 subnormal result bits even when the target's default f16
+// arithmetic mode flushes them. No intermediate f32 rounding is involved.
+__device__ static uint32_t wmma12_half_round(double value)
+{
+    const uint64_t bits = std::bit_cast<uint64_t>(value);
+    const uint32_t sign = uint32_t(bits >> 48) & 0x8000u;
+    const uint32_t exponent = uint32_t((bits >> 52) & 2047u);
+    const uint64_t fraction = bits & 0xfffffffffffffu;
+    if (exponent == 2047u) return sign | (fraction ? 0x7e00u : 0x7c00u);
+    const int power = int(exponent) - 1023;
+    if (power < -25) return sign;
+    if (power > 15) return sign | 0x7c00u;
+    const unsigned shift = power < -14 ? unsigned(28 - power) : 42u;
+    const uint64_t significand = fraction | 0x10000000000000ull;
+    uint32_t code = uint32_t(significand >> shift);
+    const uint64_t tail = significand & ((uint64_t(1) << shift) - 1);
+    const uint64_t midpoint = uint64_t(1) << (shift - 1);
+    code += tail > midpoint || (tail == midpoint && (code & 1u));
+    if (power >= -14) code += uint32_t(power + 14) << 10;
+    return sign | code;
+}
+
+__device__ static wmma_uint4 wmma12_reference_c(uint2::Native_vec_ c0, uint2::Native_vec_ c1, bool paired)
+{
+    const bool high = wmma12_half() != 0;
+    const uint2::Native_vec_ own = paired && high ? c1 : c0;
+    const uint2::Native_vec_ send = paired && !high ? c1 : c0;
+    const uint2::Native_vec_ other = {wmma12_other_half(send.x), wmma12_other_half(send.y)};
+    const uint2::Native_vec_ even = paired && high ? other : own;
+    const uint2::Native_vec_ odd = paired && high ? own : other;
+    return {(even.x & 0xffffu) | (odd.x << 16), (even.x >> 16) | (odd.x & 0xffff0000u),
+            (even.y & 0xffffu) | (odd.y << 16), (even.y >> 16) | (odd.y & 0xffff0000u)};
+}
+
+__device__ static wmma_uint4 wmma12_f16_reference(wmma_uint8 a, wmma_uint8 b, wmma_uint4 c)
+{
+    // x/y: packed even rows, z/w: packed odd rows, in this half-wave.
+    wmma_uint4 result = {};
+    const uint32_t half = wmma12_half();
+    for (uint32_t i = 0; i < 8; ++i)
+    {
+        const uint32_t row = i + 8 * half;
+        double sum = wmma12_half_value((c[i / 2] >> (16 * (i & 1))) & 0xffffu);
+        for (uint32_t khalf = 0; khalf < 2; ++khalf)
+            for (uint32_t j = 0; j < 4; ++j)
+            {
+                const uint32_t av = wmma_from_lane(row + 16 * khalf, a[j]);
+                const uint32_t other = wmma12_other_half(b[j]);
+                const uint32_t bv = half == khalf ? b[j] : other;
+                sum += wmma12_half_value(av & 0xffffu) * wmma12_half_value(bv & 0xffffu);
+                sum += wmma12_half_value(av >> 16) * wmma12_half_value(bv >> 16);
+            }
+        // Do not round through f32: that can reintroduce the midpoint error.
+        result[(i & 1) * 2 + i / 4] |= wmma12_half_round(sum) << (16 * ((i / 2) & 1));
+    }
+    return result;
+}
