diff --git a/OptiScaler/spoofing/BackendIdentity.h b/OptiScaler/spoofing/BackendIdentity.h
new file mode 100644
index 0000000..c0e6a19
--- /dev/null
+++ b/OptiScaler/spoofing/BackendIdentity.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <string_view>
+
+// Physical hardware identity is independent of external DLSS availability.
+namespace BackendIdentity
+{
+inline bool AllowDlss(bool isNvidia, bool allowExternalBackend, bool explicitBackendFile)
+{
+    return isNvidia || (allowExternalBackend && explicitBackendFile);
+}
+
+inline bool IsAmdFsrCaller(std::string_view caller)
+{
+    constexpr std::string_view modules[] = {
+        "amdxc64.dll", "amdxcffx64.dll", "amd_fidelityfx_dx12.dll",
+        "amd_fidelityfx_loader_dx12.dll", "amd_fidelityfx_upscaler_dx12.dll",
+        "amd_fidelityfx_framegeneration_dx12.dll", "amd_fidelityfx_denoiser_dx12.dll",
+        "amd_fidelityfx_radiancecache_dx12.dll"
+    };
+    for (auto module : modules)
+    {
+        if (caller.size() != module.size())
+            continue;
+        bool match = true;
+        for (size_t index = 0; index < caller.size(); ++index)
+        {
+            const char c = caller[index];
+            const char lower = c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c;
+            if (lower != module[index])
+            {
+                match = false;
+                break;
+            }
+        }
+        if (match)
+            return true;
+    }
+    return false;
+}
+}
