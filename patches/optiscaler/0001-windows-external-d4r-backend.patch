+            return NVSDK_NGX_Result_Fail;
+        }
         LOG_ERROR("Feature '{}' initialization failed falling back to FSR 2.1.2", UpscalerDisplayName(upscalerBackend));
         state.newBackend = Upscaler::FSR21;
         state.changeBackend[handleId] = true;
@@ -1027,6 +1038,12 @@ static NVSDK_NGX_Result TryEvaluateOptiFeature(ID3D12GraphicsCommandList* InCmdL
     // Fallback to FSR 2.1.2 if feature failed to initialize and user didn't explicitly request it
     if (!feature->IsInited() && cfg.Dx12Upscaler.value_or_default() != Upscaler::FSR21)
     {
+        if (state.dlssExternalBackend && cfg.Dx12Upscaler.value_or_default() == Upscaler::DLSS)
+        {
+            LOG_ERROR("External DLSS feature is not initialized; refusing FSR fallback");
+            D3D12Hooks::SetRootSignatureTracking(true);
+            return NVSDK_NGX_Result_Fail;
+        }
         LOG_WARN("Feature '{}' failed to initialize. Falling back to FSR 2.1.2", feature->Name());
         ImGui::InsertNotification({ ImGuiToastType::Warning, 10000, "Falling back to FSR 2.1.2" });
 
diff --git a/OptiScaler/misc/IdentifyGpu.cpp b/OptiScaler/misc/IdentifyGpu.cpp
index 3877f9f..6c05904 100644
--- a/OptiScaler/misc/IdentifyGpu.cpp
+++ b/OptiScaler/misc/IdentifyGpu.cpp
@@ -8,6 +8,7 @@
 #include <proxies/D3d12_Proxy.h>
 #include "nvapi/NvApiTypes.h"
 #include <hooks/Amdxc64_Hooks.h>
+#include <proxies/NVNGX_Proxy.h>
 
 using Microsoft::WRL::ComPtr;
 
@@ -187,6 +188,25 @@ std::vector<GpuInformation> IdentifyGpu::checkGpuInfo()
 
     for (auto& gpuInfo : localCachedInfo)
     {
+        if (State::Instance().dlssExternalBackend && !gpuInfo.softwareAdapter)
+        {
+            // Query the configured D3D12 backend outside DLL_PROCESS_ATTACH.
+            // Preserve vendor/device/architecture data obtained from DXGI.
+            auto requirements = NVNGXProxy::D3D12_GetFeatureRequirements();
+            ComPtr<IDXGIAdapter1> physicalAdapter;
+            if (requirements && SUCCEEDED(factory->EnumAdapterByLuid(gpuInfo.luid, IID_PPV_ARGS(&physicalAdapter))))
+            {
+                NVSDK_NGX_FeatureDiscoveryInfo discovery {};
+                discovery.SDKVersion = NVSDK_NGX_Version_API;
+                discovery.FeatureID = NVSDK_NGX_Feature_SuperSampling;
+                NVSDK_NGX_FeatureRequirement supported {};
+                const auto result = requirements(physicalAdapter.Get(), &discovery, &supported);
+                gpuInfo.dlssCapable = result == NVSDK_NGX_Result_Success &&
+                    supported.FeatureSupported == NVSDK_NGX_FeatureSupportResult_Supported;
+                LOG_INFO("External D3D12 DLSS backend: {} support={} result={:X}",
+                         gpuInfo.name, gpuInfo.dlssCapable, (unsigned) result);
+            }
+        }
         if (gpuInfo.vendorId == VendorId::Nvidia)
         {
             queryNvapi(gpuInfo);
