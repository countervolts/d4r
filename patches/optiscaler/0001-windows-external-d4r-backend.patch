diff --git a/OptiScaler/Util.cpp b/OptiScaler/Util.cpp
index f7ac6fa..7367a91 100644
--- a/OptiScaler/Util.cpp
+++ b/OptiScaler/Util.cpp
@@ -486,8 +486,16 @@ bool Util::GetFileVersion(std::wstring dllPath, version_t* fileVersionOut, versi
 
 bool Util::IsSubpath(const std::filesystem::path& path, const std::filesystem::path& base)
 {
-    auto rel = std::filesystem::relative(path, base);
-    auto first = *rel.begin();
+    // Called by LdrLoadDll hooks: relative()/weakly_canonical() perform file
+    // queries, can re-enter the hooks, and throw when an optional directory or
+    // a bare DLL search name cannot be resolved. This is a lexical routing
+    // check, not a filesystem access control decision.
+    auto normalizedPath = std::filesystem::path(ToLower(path.lexically_normal().wstring()));
+    auto normalizedBase = std::filesystem::path(ToLower(base.lexically_normal().wstring()));
+    auto rel = normalizedPath.lexically_relative(normalizedBase);
+    if (rel.empty())
+        return false;
+    const auto first = *rel.begin();
     return first != "." && first != "..";
 }
 
diff --git a/OptiScaler/dllmain.cpp b/OptiScaler/dllmain.cpp
index cba14b1..b4b786e 100644
--- a/OptiScaler/dllmain.cpp
+++ b/OptiScaler/dllmain.cpp
@@ -948,7 +948,7 @@ static void CheckWorkingMode()
 
     // NVAPI
     // Doesn't seem to like GetModuleHandle for some reason, so call our load to make sure
-    if (GetDllNameWModule(&nvapiNamesW) != nullptr)
+    if (!State::Instance().dlssExternalBackend && GetDllNameWModule(&nvapiNamesW) != nullptr)
     {
         // This hooks nvapi as well when possible
         auto nvapi64 = LibraryLoadHooks::LoadNvApi();
@@ -1958,7 +1958,33 @@ BOOL APIENTRY DllMain(HMODULE hModule, DWORD ul_reason_for_call, LPVOID lpReserv
             return nvidiaDetected;
         };
 
-        bool possibleNvidia = isNvidiaViaNvapi();
+        // Opt in only to a configured, versioned Windows d4r backend. The
+        // marker performs no HIP/NGX initialization under DLL_PROCESS_ATTACH.
+        // GPU support is still checked by its public NGX requirements API.
+        if (Config::Instance()->DLSSEnabled.value_or_default() &&
+            Config::Instance()->DLSSAllowExternalBackend.value_or_default() &&
+            Config::Instance()->NvngxPath.has_value())
+        {
+            auto backendPath = std::filesystem::path(Config::Instance()->NvngxPath.value()) / L"_nvngx.dll";
+            if (backendPath.is_absolute())
+            {
+                auto module = NtdllProxy::LoadLibraryExW_Ldr(backendPath.c_str(), nullptr,
+                    LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+                if (module)
+                {
+                    using BackendVersion = unsigned (*)();
+                    auto version = reinterpret_cast<BackendVersion>(
+                        KernelBaseProxy::GetProcAddress_()(module, "d4r_WindowsBackendVersion"));
+                    State::Instance().dlssExternalBackend = version && version() == 1;
+                    NtdllProxy::FreeLibrary_Ldr(module);
+                }
+            }
+            if (State::Instance().dlssExternalBackend)
+                spdlog::info("Validated external Windows d4r DLSS backend; retaining physical GPU identity");
+            else
+                spdlog::error("AllowExternalBackend requires an absolute NvngxPath containing Windows d4r ABI 1");
+        }
+        bool possibleNvidia = !State::Instance().dlssExternalBackend && isNvidiaViaNvapi();
 
         spdlog::info("");
         spdlog::info("Check for DLSS files");
@@ -1992,7 +2018,8 @@ BOOL APIENTRY DllMain(HMODULE hModule, DWORD ul_reason_for_call, LPVOID lpReserv
             State::Instance().NVNGX_DLSSG_Path = Util::FindFilePath(exePath, "nvngx_dlssg.dll");
 
         // Not 100% accurate for Nvidia cards without DLSS
-        if (Config::Instance()->DLSSEnabled.value_or_default() && possibleNvidia)
+        if (Config::Instance()->DLSSEnabled.value_or_default() &&
+            (possibleNvidia || State::Instance().dlssExternalBackend))
         {
             if (State::Instance().NVNGX_DLSS_Path.has_value())
             {
diff --git a/OptiScaler/hooks/LibraryLoad_Hooks.cpp b/OptiScaler/hooks/LibraryLoad_Hooks.cpp
index 90bdb89..108ea5b 100644
--- a/OptiScaler/hooks/LibraryLoad_Hooks.cpp
+++ b/OptiScaler/hooks/LibraryLoad_Hooks.cpp
@@ -46,6 +46,18 @@ HMODULE LibraryLoadHooks::LoadLibraryCheckW(std::wstring libName, LPCWSTR lpLibF
 {
     auto libNameA = wstring_to_string(libName);
 
+    // The external D3D12 shim itself uses a locally supplied CUDA NGX core.
+    // Keep that exact absolute path distinct from game-facing NGX interception.
+    if (State::Instance().dlssExternalBackend)
+    {
+        wchar_t corePath[32768] {};
+        const auto length = GetEnvironmentVariableW(L"D4R_NGX_CORE", corePath, 32768);
+        if (length && length < 32768 &&
+            Util::ToLower(std::filesystem::path(libName).lexically_normal().wstring()) ==
+                Util::ToLower(std::filesystem::path(corePath).lexically_normal().wstring()))
+            return nullptr;
+    }
+
 #ifdef LOG_LIB_OPERATIONS
     LOG_TRACE("{}", libNameA);
 #endif
@@ -132,6 +144,11 @@ HMODULE LibraryLoadHooks::LoadLibraryCheckW(std::wstring libName, LPCWSTR lpLibF
     // NvApi64.dll
     if (CheckDllNameW(&libName, &nvapiNamesW))
     {
+        // An explicit external CUDA backend owns its NVAPI topology provider.
+        // Returning OptiScaler's fake-NVAPI would replace that provider and can
+        // recurse into DXGI while the NGX loader holds the loader lock.
+        if (State::Instance().dlssExternalBackend)
+            return nullptr; // Continue through the original loader.
         LOG_INFO("{} call!", libNameA);
 
         return LibraryLoadHooks::LoadNvApi();
