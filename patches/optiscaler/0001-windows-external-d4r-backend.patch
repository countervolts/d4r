@@ -705,6 +706,16 @@ static NVSDK_NGX_Result TryCreateOptiFeature(ID3D12GraphicsCommandList* InCmdLis
     }
     else
     {
+        if (state.dlssExternalBackend && upscalerBackend == Upscaler::DLSS)
