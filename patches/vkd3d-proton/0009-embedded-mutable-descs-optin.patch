+        /* Opt in to extreme speed mode.
+         * Embedded mutable descriptors carry no vkd3d metadata (the CPU handle
+         * is the descriptor payload itself), which breaks NVX CUDA texture
+         * handle creation: vkGetImageViewHandleNVX requires a VkSampler / image
+         * view pair that only exists in classic descriptor metadata. Payloads
+         * are also overwritten in place, tearing against split-timeline command
+         * streams (DLSS-G multi-frame generation). Off by default; enable per
+         * title with VKD3D_CONFIG=embedded_mutable_descs. */
+        if (VKD3D_CONFIG_FLAG_IS_SET(EMBEDDED_MUTABLE_DESCS) &&
