+// Pin a loaded module by its base file name, even if it is registered under a
+// different path than expected (e.g. Wine registers game-local DLLs under their
+// full 'Z:\...' drive path instead of 'C:\windows\system32\...').
+static HMODULE pin_module_by_filename(const std::filesystem::path &filename)
+{
+	HMODULE modules[1024];
+	DWORD cb_needed = 0;
+	if (!EnumProcessModulesEx(GetCurrentProcess(), modules, static_cast<DWORD>(sizeof(modules)), &cb_needed, LIST_MODULES_ALL))
+		return nullptr;
+
+	for (auto it = std::begin(modules); it != std::end(modules); ++it)
+	{
+		wchar_t full_name[MAX_PATH] {};
+		if (GetModuleFileNameExW(GetCurrentProcess(), *it, full_name, MAX_PATH) == 0)
+			continue;
+
+		if (_wcsicmp(filename.c_str(), std::filesystem::path(full_name).filename().c_str()) != 0)
+			continue;
+
+		HMODULE pinned = nullptr;
+		if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_PIN, full_name, &pinned) || pinned == g_module_handle)
+			return nullptr;
+
+		return pinned;
+	}
+
+	return nullptr;
+}
