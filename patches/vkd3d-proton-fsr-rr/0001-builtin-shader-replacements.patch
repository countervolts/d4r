diff --git a/libs/vkd3d-shader/vkd3d_shader_main.c b/libs/vkd3d-shader/vkd3d_shader_main.c
index 58bf038d..c0c9e838 100644
--- a/libs/vkd3d-shader/vkd3d_shader_main.c
+++ b/libs/vkd3d-shader/vkd3d_shader_main.c
@@ -84,6 +84,41 @@ err:
     return false;
 }
 
+#include "d4r_builtin_shaders.h"
+
+/* d4r: built-in replacements for the FSR Ray Regeneration denoiser's network layers, used only on the RDNA3
+ * emulation path (DXIL_SPIRV_CONFIG contains wmma_rdna3_workaround). D4R_BUILTIN_SHADERS=0 disables them. */
+static bool d4r_builtin_replace(vkd3d_shader_hash_t hash, const void **data, size_t *size)
+{
+    static int enabled = -1;
+    char env[256];
+    size_t i;
+
+    if (enabled < 0)
+    {
+        enabled = vkd3d_get_env_var("DXIL_SPIRV_CONFIG", env, sizeof(env)) && strstr(env, "wmma_rdna3_workaround");
+        if (vkd3d_get_env_var("D4R_BUILTIN_SHADERS", env, sizeof(env)) && strcmp(env, "0") == 0)
+            enabled = 0;
+    }
+    if (!enabled)
+        return false;
+    for (i = 0; i < ARRAY_SIZE(d4r_builtin_shaders); i++)
+    {
+        if (d4r_builtin_shaders[i].hash == hash)
+        {
+            void *copy = vkd3d_malloc(d4r_builtin_shaders[i].size);
+            if (!copy)
+                return false;
+            memcpy(copy, d4r_builtin_shaders[i].code, d4r_builtin_shaders[i].size);
+            *data = copy;
+            *size = d4r_builtin_shaders[i].size;
+            INFO("d4r: built-in SPIR-V replacement for shader hash %016"PRIx64".\n", hash);
+            return true;
+        }
+    }
+    return false;
+}
+
 bool vkd3d_shader_replace(vkd3d_shader_hash_t hash, const void **data, size_t *size)
 {
     static bool enabled = true;
@@ -91,12 +126,12 @@ bool vkd3d_shader_replace(vkd3d_shader_hash_t hash, const void **data, size_t *s
     char filename[1024];
 
     if (!enabled)
-        return false;
+        return d4r_builtin_replace(hash, data, size);
 
     if (!vkd3d_get_env_var("VKD3D_SHADER_OVERRIDE", path, sizeof(path)))
     {
         enabled = false;
-        return false;
+        return d4r_builtin_replace(hash, data, size);
     }
 
     snprintf(filename, ARRAY_SIZE(filename), "%s/%016"PRIx64".spv", path, hash);
